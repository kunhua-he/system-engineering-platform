{
 "包id": "模块库.知识检索",
 "名称": "知识检索",
 "类型": "基础模块",
 "版本": "1.0.0",
 "说明": "组合 嵌入缓存/重排服务/文件系统 完成知识检索流程。模块只持能力 id 与契约版本。",
 "入口": "__init__.py",
 "依赖": [
  {
   "能力": "大语言模型支持库.嵌入缓存.查询嵌入",
   "版本": ">=1.0.0"
  },
  {
   "能力": "大语言模型支持库.重排服务.重排",
   "版本": ">=1.0.0"
  },
  {
   "能力": "文件系统支持库.文件操作.列出目录",
   "版本": ">=1.0.0"
  },
  {
   "能力": "文件系统支持库.文件操作.读取文件",
   "版本": ">=1.0.0"
  }
 ],
 "能力": [
  {
   "能力id": "知识检索.检索知识",
   "名称": "检索知识",
   "参数": [
    {
     "名称": "查询",
     "类型": "文本型",
     "必填": true,
     "默认值": null,
     "说明": "检索查询"
    },
    {
     "名称": "知识库",
     "类型": "文本型",
     "必填": true,
     "默认值": null,
     "说明": "知识库目录"
    },
    {
     "名称": "模型名",
     "类型": "文本型",
     "必填": false,
     "默认值": "bge-m3",
     "说明": "嵌入模型名"
    },
    {
     "名称": "提供者",
     "类型": "文本型",
     "必填": false,
     "默认值": "本地",
     "说明": "提供者标识"
    },
    {
     "名称": "顶部数量",
     "类型": "整数型",
     "必填": false,
     "默认值": 5,
     "说明": "返回顶部 N 条"
    }
   ],
   "返回": "结果型",
   "说明": "检索并重排知识"
  },
  {
   "能力id": "知识检索.检查可用性",
   "名称": "检查可用性",
   "参数": [
    {
     "名称": "知识库",
     "类型": "文本型",
     "必填": false,
     "默认值": null,
     "说明": "知识库路径"
    }
   ],
   "返回": "结果型",
   "说明": "检查模块可用性"
  }
 ]
}