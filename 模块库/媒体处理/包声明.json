{
 "包id": "模块库.媒体处理",
 "名称": "媒体处理",
 "类型": "基础模块",
 "版本": "1.0.1",
 "说明": "组合 FFmpeg 支持库公开能力（基础模块）：检查提供者、探测媒体（时长/流/格式）、提取音频（wav/mp3等，字节返回）、转码（编码选项白名单透传）、抽取帧；只经 获取能力调用器().调用能力 调用，错误码统一透传。",
 "入口": "__init__.py",
 "依赖": [
  {
   "能力": "媒体处理支持库.FFmpeg媒体.检查提供者",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.探测媒体",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.提取音频",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.转码",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.抽取帧",
   "版本": ">=1.0.0"
  }
 ],
 "能力": [
  {
   "能力id": "媒体处理.检查提供者",
   "名称": "检查媒体处理提供者",
   "参数": [
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "成功": "逻辑型",
     "值": "字典（版本：文本）",
     "错误": "字典（错误码/说明/来源）"
    }
   },
   "说明": "检查 ffmpeg/ffprobe 可用性并返回版本；缺失 → 提供者不可用"
  },
  {
   "能力id": "媒体处理.探测媒体",
   "名称": "探测媒体",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "时长秒": "浮点数",
     "流": "列表型",
     "格式": "文本型",
     "大小字节": "整数型",
     "比特率": "整数型"
    }
   },
   "说明": "探测媒体文件：{时长秒, 流, 格式, 大小字节, 比特率}；损坏 → 损坏媒体"
  },
  {
   "能力id": "媒体处理.提取音频",
   "名称": "提取音频",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型",
     "格式": "文本型",
     "字节数": "整数型"
    }
   },
   "说明": "从视频提取首个音频轨（wav/mp3/aac/m4a/ogg/flac），字节经 b64 返回；无音轨 → 无音轨"
  },
  {
   "能力id": "媒体处理.转码",
   "名称": "转码",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "编码选项",
     "类型": "字典型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型",
     "格式": "文本型",
     "字节数": "整数型"
    }
   },
   "说明": "ffmpeg 转码（mp4/mkv/webm/mov/avi），编码选项白名单：分辨率/视频码率/音频码率/帧率"
  },
  {
   "能力id": "媒体处理.抽取帧",
   "名称": "抽取帧",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "时间点秒",
     "类型": "双精度数型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型",
     "格式": "文本型",
     "宽度": "整数型",
     "高度": "整数型"
    }
   },
   "说明": "ffmpeg 抽帧（jpg/png，时间点秒），字节经 b64 返回：{字节b64, 格式, 宽度, 高度}"
  }
 ]
}