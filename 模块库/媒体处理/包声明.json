{
 "包id": "模块库.媒体处理",
 "名称": "媒体处理",
 "类型": "基础模块",
 "版本": "1.0.3",
 "说明": "组合 FFmpeg 支持库公开能力（基础模块）：检查提供者、探测媒体（时长/流/格式）、提取音频（wav/mp3等，字节返回）、转码（编码选项白名单透传）、抽取帧；只经 获取能力调用器().调用能力 调用，错误码统一透传。",
 "入口": "__init__.py",
 "依赖": [
  {
   "能力": "媒体处理支持库.FFmpeg媒体.检查提供者",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.探测媒体",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.提取音频",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.转码",
   "版本": ">=1.0.0"
  },
  {
   "能力": "媒体处理支持库.FFmpeg媒体.抽取帧",
   "版本": ">=1.0.0"
  }
 ],
 "能力": [
  {
   "能力id": "媒体处理.检查提供者",
   "名称": "检查媒体处理提供者",
   "参数": [
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "成功": "逻辑型，调用是否成功（统一结果信封）",
     "值": "字典型，提供者信息：版本（ffmpeg/ffprobe 版本号）",
     "错误": "字典型，失败时的错误信息：错误码 / 说明 / 来源"
    }
   },
   "说明": "检查 ffmpeg/ffprobe 可用性并返回版本；缺失 → 提供者不可用"
  },
  {
   "能力id": "媒体处理.探测媒体",
   "名称": "探测媒体",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "时长秒": "浮点数，媒体总时长（秒）",
     "流": "列表型，媒体流清单（每项含流类型/编码等，来自 ffprobe）",
     "格式": "文本型，容器格式名（如 mp4/mkv/webm）",
     "大小字节": "整数型，媒体文件字节数",
     "比特率": "整数型，总比特率（bps）"
    }
   },
   "说明": "探测媒体文件：{时长秒, 流, 格式, 大小字节, 比特率}；损坏 → 损坏媒体"
  },
  {
   "能力id": "媒体处理.提取音频",
   "名称": "提取音频",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型，提取出的音频字节 base64 文本",
     "格式": "文本型，输出音频格式（wav/mp3/aac/m4a/ogg/flac）",
     "字节数": "整数型，输出音频字节数"
    }
   },
   "说明": "从视频提取首个音频轨（wav/mp3/aac/m4a/ogg/flac），字节经 b64 返回；无音轨 → 无音轨"
  },
  {
   "能力id": "媒体处理.转码",
   "名称": "转码",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "编码选项",
     "类型": "字典型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    },
    {
     "名称": "返回字节",
     "类型": "逻辑型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型，转码后媒体字节的 base64 文本（可选返回）",
     "格式": "文本型，输出容器格式（mp4/mkv/webm/mov/avi）",
     "字节数": "整数型，转码后字节数"
    }
   },
   "说明": "ffmpeg 转码（mp4/mkv/webm/mov/avi）：返回 {格式, 字节数, 输出路径}（可选 字节b64）；编码选项白名单：分辨率/视频码率/音频码率/帧率/视频编码器/音频编码器/码率上限/缓冲/视频标签/预设；Apple Silicon 推荐 h264_videotoolbox/hevc_videotoolbox 硬编"
  },
  {
   "能力id": "媒体处理.抽取帧",
   "名称": "抽取帧",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "时间点秒",
     "类型": "双精度数型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "最大时长秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "字节b64": "文本型，抽取帧图像字节的 base64 文本",
     "格式": "文本型，帧图像格式（jpg/png）",
     "宽度": "整数型，帧图像宽度（像素）",
     "高度": "整数型，帧图像高度（像素）"
    }
   },
   "说明": "ffmpeg 抽帧（jpg/png，时间点秒），字节经 b64 返回：{字节b64, 格式, 宽度, 高度}"
  },
  {
   "能力id": "媒体处理.拼接媒体",
   "名称": "拼接媒体",
   "参数": [
    {
     "名称": "文件列表",
     "类型": "列表型"
    },
    {
     "名称": "输出格式",
     "类型": "文本型"
    },
    {
     "名称": "输出路径",
     "类型": "文本型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数型"
    },
    {
     "名称": "返回字节",
     "类型": "逻辑型"
    }
   ],
   "返回": "结果型",
   "说明": "按顺序无损拼接多个同源分片成一个文件（concat demuxer + -c copy，不重编码）；模块层门面，经唯一网关调用 FFmpeg 支持库原子能力；错误码透传"
  }
 ]
}