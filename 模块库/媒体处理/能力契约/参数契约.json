{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "媒体处理.检查提供者",
      "版本": "1.0.0",
      "说明": "检查 ffmpeg/ffprobe 可用性并返回版本；缺失 → 提供者不可用",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 30,
          "说明": "版本探针超时预留参数（当前版本经支持库默认探针执行）"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "字典（版本：文本）",
          "错误": "字典（错误码/说明/来源）"
        }
      },
      "错误码": [
        "参数不合法",
        "提供者不可用"
      ],
      "调用示例": {
        "能力id": "媒体处理.检查提供者",
        "参数": {
          "超时秒": 30
        }
      }
    },
    {
      "能力id": "媒体处理.探测媒体",
      "版本": "1.0.0",
      "说明": "探测媒体文件：{时长秒, 流, 格式, 大小字节, 比特率}；损坏 → 损坏媒体",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "媒体文件绝对路径"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "探测超时"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "时长秒": "浮点数",
          "流": "列表",
          "格式": "文本",
          "大小字节": "整数",
          "比特率": "整数"
        }
      },
      "错误码": [
        "参数不合法",
        "文件不存在",
        "提供者不可用",
        "损坏媒体",
        "超时",
        "取消",
        "进程崩溃"
      ],
      "调用示例": {
        "能力id": "媒体处理.探测媒体",
        "参数": {
          "文件路径": "示例媒体.mp4",
          "超时秒": 60
        }
      }
    },
    {
      "能力id": "媒体处理.提取音频",
      "版本": "1.0.0",
      "说明": "从视频提取首个音频轨（wav/mp3/aac/m4a/ogg/flac），字节经 b64 返回；无音轨 → 无音轨",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "媒体文件绝对路径"
        },
        {
          "名称": "输出格式",
          "类型": "文本",
          "必填": false,
          "默认值": "wav",
          "说明": "wav/mp3/aac/m4a/ogg/flac"
        },
        {
          "名称": "输出路径",
          "类型": "文本",
          "必填": false,
          "默认值": null,
          "说明": "可选输出文件绝对路径（缺省临时文件由支持库自动清理）"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "提取超时"
        },
        {
          "名称": "最大输出字节",
          "类型": "整数",
          "必填": false,
          "默认值": 209715200,
          "说明": "输出大小上限"
        },
        {
          "名称": "最大时长秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 7200,
          "说明": "媒体时长上限，超过 → 超长媒体"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "字节b64": "文本",
          "格式": "文本",
          "字节数": "整数"
        }
      },
      "错误码": [
        "参数不合法",
        "文件不存在",
        "提供者不可用",
        "损坏媒体",
        "无音轨",
        "超长媒体",
        "超时",
        "取消",
        "进程崩溃",
        "超出限制"
      ],
      "调用示例": {
        "能力id": "媒体处理.提取音频",
        "参数": {
          "文件路径": "示例媒体.mp4",
          "输出格式": "wav"
        }
      }
    },
