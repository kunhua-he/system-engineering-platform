[
 {
  "能力id": "项目文档.登记项目",
  "名称": "登记项目",
  "说明": "登记一个项目：先校验项目根与文档根真实存在、判据文件就位，再写入登记表（同项目名覆盖更新，幂等）；项目根不存在返回 目录不存在。支持库的存储能力不校验目录存在性，边界校验在模块层做。返回登记档案与文档根绝对路径、判据文件及其就位状态。",
  "版本": "1.0.0",
  "参数": [
   "项目名",
   "项目根目录",
   "文档根相对路径",
   "规范文件",
   "库文件"
  ],
  "返回": {
   "类型": "结果型",
   "值结构": {
    "项目名": "文本型",
    "项目根目录": "文本型",
    "文档根相对路径": "文本型",
    "规范文件": "文本型",
    "是否新增": "逻辑型",
    "文档根绝对路径": "文本型",
    "判据文件": "文本型",
    "判据文件就位": "逻辑型"
   }
  },
  "错误码": [
   "参数不合法",
   "目录不存在",
   "项目未登记",
   "索引库不可用",
   "提供者不可用"
  ]
 },
 {
  "能力id": "项目文档.写文档",
  "名称": "写文档",
  "说明": "按规范判据校验正文，合规才落盘成 md，并在后台线程（非守护、单次、30 秒硬超时）入库；不合规不落盘，单独返回违规范清单（判据id/严重级/行号）。判据文件缺失返回 判据文件不存在，不假装通过；目标已存在且未声明覆盖返回 已存在；路径越出文档根返回 路径越界。入库失败不回滚已落盘文件（文件是权威、索引是派生）。",
  "版本": "1.0.0",
  "参数": [
   "项目名",
   "文档相对路径",
   "正文",
   "判据文件",
   "是否权威文档",
   "覆盖",
   "库文件",
   "等待入库完成"
  ],
  "返回": {
   "类型": "结果型",
   "值结构": {
    "项目名": "文本型",
    "文档相对路径": "文本型",
    "文档绝对路径": "文本型",
    "判据文件": "文本型",
    "入库": "字典型（已受理/是否完成/说明）"
   }
  },
  "错误码": [
   "参数不合法",
   "目录不存在",
   "路径越界",
   "已存在",
   "判据文件不存在",
   "项目未登记",
   "索引库不可用",
   "提供者不可用",
   "内部错误"
  ]
 },
 {
