    {
     "名称": "句柄",
     "类型": "整数型",
     "必填": false,
     "默认值": 0,
     "说明": "子进程资源必传：系统核心支持库.进程管理.启动进程 返回的句柄（由 申请资源 本能力自身（资源句柄由本次调用返回，登记在受管状态） 返回）"
    }
