{
  "契约版本": "验证场景/v1",
  "验证场景": [
    {
      "场景id": "测试资源.申请与回收正向",
      "前置步骤": [
        {
          "步骤id": "建测试资源临时根",
          "能力id": "文件系统支持库.文件操作.创建目录",
          "参数": {
            "目录路径": {
              "$动态": "受管临时目录",
              "相对路径": "测试资源临时根"
            },
            "递归": true
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值": true
            }
          }
        },
        {
          "步骤id": "写待回收资源文件",
          "能力id": "文件系统支持库.文件操作.写入文件",
          "参数": {
            "文件路径": {
              "$动态": "受管临时路径",
              "相对路径": "测试资源临时根/资源.txt"
            },
            "内容": "测试资源验收内容\n",
            "编码": "utf-8"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值": true
            }
          }
        }
      ],
      "目标步骤": [
        {
          "步骤id": "申请一条文件类测试资源",
          "能力id": "测试资源.申请资源",
          "参数": {
            "临时根目录": {
              "$动态": "受管临时目录",
              "相对路径": "测试资源临时根"
            },
            "清单路径": {
              "$动态": "受管临时路径",
              "相对路径": "测试资源临时根/开工清单.jsonl"
            },
            "资源路径": {
              "$动态": "受管临时路径",
              "相对路径": "测试资源临时根/资源.txt"
            },
            "资源类型": "文件",
            "保留": false,
            "开工id": "验收开工1"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值类型": "字典型",
              "关键值": {
                "成功": true,
                "类型": "文件",
                "保留": false,
                "work_id": "验收开工1"
              },
              "必需字段": [
                "成功",
                "路径",
                "类型",
                "保留",
                "标识",
                "work_id"
              ]
            }
          }
        },
        {
          "步骤id": "回收未保留的测试资源",
          "能力id": "测试资源.回收资源",
          "参数": {
            "临时根目录": {
              "$动态": "受管临时目录",
              "相对路径": "测试资源临时根"
            },
            "清单路径": {
              "$动态": "受管临时路径",
              "相对路径": "测试资源临时根/开工清单.jsonl"
            },
            "证据目录": {
              "$动态": "受管临时目录",
              "相对路径": "测试资源证据"
            },
            "开工id": "验收开工1"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值类型": "字典型",
              "关键值": {
                "成功": true,
                "清理数": 1,
                "保留数": 0
              },
              "必需字段": [
                "成功",
                "清理数",
                "保留数",
                "失败表",
                "证据路径"
              ]
            }
          }
        }
      ],
      "清理步骤": [
        {
          "步骤id": "确认回收后资源已不在",
          "能力id": "文件系统支持库.文件操作.判断存在",
          "参数": {
            "文件路径": {
              "$动态": "受管临时路径",
              "相对路径": "测试资源临时根/资源.txt"
            }
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值": false
            }
          }
        }
      ]
    }
  ]
}
