{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "自修复工具.创建修复工作区",
      "版本": "1.0.0",
      "说明": "Git worktree + 精确补丁 + 定向验证 + 可回滚提交组合流程",
      "参数": [
        {
          "名称": "仓库路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "仓库目录绝对路径"
        },
        {
          "名称": "补丁列表",
          "类型": "列表",
          "必填": true,
          "默认值": null,
          "说明": "补丁项含 文件(相对路径)/旧内容/新内容 字段"
        },
        {
          "名称": "验证命令",
          "类型": "列表",
          "必填": true,
          "默认值": null,
          "说明": "受管执行命令参数列表（禁 shell）"
        },
        {
          "名称": "提交消息",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "单行提交消息"
        },
        {
          "名称": "期望摘要",
          "类型": "文本",
          "必填": false,
          "默认值": "",
          "说明": "可选：检查文件期望 sha256 摘要"
        },
        {
          "名称": "检查文件",
          "类型": "文本",
          "必填": false,
          "默认值": "",
          "说明": "可选：摘要检查相对路径"
        },
        {
          "名称": "分支名",
          "类型": "文本",
          "必填": false,
          "默认值": "",
          "说明": "可选：修复工作区分支名"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "命令超时"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "路径": "工作区路径",
          "分支": "工作区分支",
          "提交": "提交哈希",
          "摘要": "验证摘要",
          "工作区清理": "已关闭或错误码"
        }
      },
      "错误码": [
        "参数不合法",
        "提供者不可用",
        "路径逃逸",
        "补丁多重匹配",
        "验证失败",
        "未提交修改",
        "冲突"
      ],
      "调用示例": {
        "能力id": "自修复工具.创建修复工作区",
        "参数": {
          "仓库路径": "/示例/不存在/仓库",
          "补丁列表": [
            {
              "文件": "示例.txt",
              "旧内容": "旧",
              "新内容": "新"
            }
          ],
          "验证命令": [
            "git",
            "status"
          ],
          "提交消息": "示例修复"
        }
      }
    },
    {
      "能力id": "自修复工具.验证修复",
      "版本": "1.0.0",
      "说明": "应用后运行验证命令并检查内容摘要",
      "参数": [
        {
          "名称": "仓库路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "工作区或仓库目录绝对路径"
        },
        {
          "名称": "验证命令",
          "类型": "列表",
          "必填": true,
          "默认值": null,
          "说明": "受管执行命令参数列表（禁 shell）"
        },
        {
          "名称": "期望摘要",
          "类型": "文本",
          "必填": false,
          "默认值": "",
          "说明": "可选：期望 sha256 摘要"
        },
        {
          "名称": "检查文件",
          "类型": "文本",
          "必填": false,
          "默认值": "",
          "说明": "可选：摘要检查相对路径"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "命令超时"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "输出": "验证命令标准输出",
          "摘要": "检查文件摘要",
          "验证通过": true
        }
      },
      "错误码": [
        "参数不合法",
        "提供者不可用",
        "验证失败"
      ],
      "调用示例": {
        "能力id": "自修复工具.验证修复",
        "参数": {
          "仓库路径": "/示例/不存在/仓库",
          "验证命令": [
            "git",
            "status"
          ]
        }
      }
    },
    {
      "能力id": "自修复工具.回滚修复",
      "版本": "1.0.0",
      "说明": "git revert/cherry-pick 组合撤销或挑拣修复",
      "参数": [
        {
          "名称": "仓库路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "仓库目录绝对路径"
        },
        {
          "名称": "提交哈希",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "7-40 位十六进制提交哈希"
        },
        {
          "名称": "操作",
          "类型": "文本",
          "必填": false,
          "默认值": "回滚",
          "说明": "回滚(revert) 或 挑拣合入(cherry-pick)"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "命令超时"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "提交": "撤销或挑拣提交哈希"
        }
      },
      "错误码": [
        "参数不合法",
        "提供者不可用",
        "未提交修改",
        "回滚失败",
        "冲突"
      ],
      "调用示例": {
        "能力id": "自修复工具.回滚修复",
        "参数": {
          "仓库路径": "/示例/不存在/仓库",
          "提交哈希": "a1b2c3d"
        }
      }
    },
    {
      "能力id": "自修复工具.获取当前提交哈希",
      "版本": "1.0.0",
      "说明": "获取仓库当前提交哈希与分支（经 Git 支持库公开能力）",
      "参数": [
        {
          "名称": "仓库路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "仓库目录绝对路径"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "必填": false,
          "默认值": 60,
          "说明": "命令超时"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "提交哈希": "当前 HEAD 哈希",
          "分支": "当前分支名"
        }
      },
      "错误码": [
        "参数不合法",
        "提供者不可用",
        "命令失败",
        "超时",
        "取消"
      ],
      "调用示例": {
        "能力id": "自修复工具.获取当前提交哈希",
        "参数": {
          "仓库路径": "/示例/不存在/仓库"
        }
      }
    }
  ]
}
