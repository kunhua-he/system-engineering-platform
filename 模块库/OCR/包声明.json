{
  "包id": "模块库.OCR",
  "名称": "OCR",
  "类型": "基础模块",
  "版本": "1.0.0",
  "说明": "基础模块：组合 Tesseract 支持库公开能力（识别图片文字/识别图片文件/可用性检查），只经 获取能力调用器().调用能力 调用，取消令牌id 文本语义（支持库侧不传 callable）。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "OCR识别.识别图片",
      "版本": ">=1.0.0"
    },
    {
      "能力": "OCR识别.语言包列表",
      "版本": ">=1.0.0"
    },
    {
      "能力": "OCR识别.版本探针",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "OCR.识别图片文字",
      "名称": "识别图片文字",
      "参数": [
        {
          "名称": "图片路径",
          "类型": "文本",
          "说明": "图片路径（与图片字节二选一，必须且只能提供一个）"
        },
        {
          "名称": "图片字节",
          "类型": "字节",
          "说明": "图片字节（与图片路径二选一，必须且只能提供一个）"
        },
        {
          "名称": "语言",
          "类型": "文本",
          "说明": "tesseract 语言包（如 eng/chi_sim），默认 eng"
        },
        {
          "名称": "词级数据",
          "类型": "布尔",
          "说明": "是否返回词级数据 {词列表}（默认仅返回 {文本}）"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "说明": "识别超时秒数"
        },
        {
          "名称": "取消令牌id",
          "类型": "文本",
          "说明": "取消令牌id（空字符串表示不取消；平台按令牌id取消运行，支持库侧不传 callable）"
        },
        {
          "名称": "输出上限字节",
          "类型": "整数",
          "说明": "识别输出上限字节（超出返回 超出限制）"
        },
        {
          "名称": "命令路径",
          "类型": "文本",
          "说明": "tesseract 命令路径（显式优先，默认探测）"
        }
      ],
      "返回": "结果",
      "说明": "识别图片文字：图片路径与图片字节二选一，返回 {文本} 或 词级数据 {词列表}"
    },
    {
      "能力id": "OCR.识别图片文件",
      "名称": "识别图片文件",
      "参数": [
        {
          "名称": "图片路径",
          "类型": "文本",
          "说明": "图片文件路径（必填）"
        },
        {
          "名称": "语言",
          "类型": "文本",
          "说明": "tesseract 语言包（如 eng/chi_sim），默认 eng"
        },
        {
          "名称": "词级数据",
          "类型": "布尔",
          "说明": "是否返回词级数据 {词列表}（默认仅返回 {文本}）"
        },
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "说明": "识别超时秒数"
        },
        {
          "名称": "取消令牌id",
          "类型": "文本",
          "说明": "取消令牌id（空字符串表示不取消；平台按令牌id取消运行，支持库侧不传 callable）"
        },
        {
          "名称": "输出上限字节",
          "类型": "整数",
          "说明": "识别输出上限字节（超出返回 超出限制）"
        },
        {
          "名称": "命令路径",
          "类型": "文本",
          "说明": "tesseract 命令路径（显式优先，默认探测）"
        }
      ],
      "返回": "结果",
      "说明": "按图片文件路径识别文字，返回 {文本} 或 词级数据 {词列表}"
    },
    {
      "能力id": "OCR.可用性检查",
      "名称": "可用性检查",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "浮点数",
          "说明": "探测超时秒数"
        },
        {
          "名称": "命令路径",
          "类型": "文本",
          "说明": "tesseract 命令路径（显式优先，默认探测）"
        }
      ],
      "返回": "结果",
      "说明": "探测 tesseract 版本与语言包：返回 版本/满足最低版本/语言列表/数据目录/语言数量"
    }
  ]
}
