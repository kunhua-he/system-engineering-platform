{
  "包id": "模块库.OCR",
  "名称": "OCR",
  "类型": "模块",
  "版本": "1.0.0",
  "说明": "组合 Tesseract 支持库公开入口：识别图片文字（文本/词级数据）、识别图片文件（路径/字节入口）、可用性检查（版本/语言包）。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "OCR识别.识别图片",
      "版本": ">=1.0.0"
    },
    {
      "能力": "OCR识别.语言包列表",
      "版本": ">=1.0.0"
    },
    {
      "能力": "OCR识别.版本探针",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "OCR.识别图片文字",
      "名称": "识别图片文字",
      "参数": [
        {
          "名称": "图片路径",
          "类型": "任意"
        },
        {
          "名称": "图片字节",
          "类型": "任意"
        },
        {
          "名称": "语言",
          "类型": "任意"
        },
        {
          "名称": "词级数据",
          "类型": "任意"
        },
        {
          "名称": "超时秒",
          "类型": "任意"
        },
        {
          "名称": "取消事件",
          "类型": "任意"
        },
        {
          "名称": "输出上限字节",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "识别图片文字：图片路径与图片字节二选一，返回 {文本} 或 词级数据 {词列表}"
    },
    {
      "能力id": "OCR.识别图片文件",
      "名称": "识别图片文件",
      "参数": [
        {
          "名称": "图片路径",
          "类型": "任意"
        },
        {
          "名称": "语言",
          "类型": "任意"
        },
        {
          "名称": "词级数据",
          "类型": "任意"
        },
        {
          "名称": "超时秒",
          "类型": "任意"
        },
        {
          "名称": "取消事件",
          "类型": "任意"
        },
        {
          "名称": "输出上限字节",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "按图片文件路径识别文字，返回 {文本} 或 词级数据 {词列表}"
    },
    {
      "能力id": "OCR.可用性检查",
      "名称": "可用性检查",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "探测 tesseract 版本与语言包：返回 版本/满足最低版本/语言列表/数据目录/语言数量"
    }
  ]
}
