{
  "契约版本": "2.0.0",
  "能力契约": [
    {
      "能力id": "OCR.识别图片文字",
      "版本": "2.0.0",
      "说明": "识别图片文字：图片路径与图片字节二选一，返回 {文本} 或 词级数据 {词列表}",
      "参数": [
        {
          "名称": "图片路径",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "图片路径（与图片字节二选一，必须且只能提供一个）"
        },
        {
          "名称": "图片字节",
          "类型": "字节集型",
          "必填": false,
          "默认值": null,
          "说明": "图片字节（与图片路径二选一，必须且只能提供一个）"
        },
        {
          "名称": "语言",
          "类型": "文本型",
          "必填": false,
          "默认值": "eng",
          "说明": "tesseract 语言包（如 eng/chi_sim），默认 eng"
        },
        {
          "名称": "词级数据",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "是否返回词级数据 {词列表}（默认仅返回 {文本}）"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 60.0,
          "说明": "识别超时秒数"
        },
        {
          "名称": "取消令牌id",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "取消令牌id（空字符串表示不取消；平台按令牌id取消运行，支持库侧不传 callable）"
        },
        {
          "名称": "输出上限字节",
          "类型": "整数型",
          "必填": false,
          "默认值": null,
          "说明": "识别输出上限字节（超出返回 超出限制）"
        },
        {
          "名称": "命令路径",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "tesseract 命令路径（显式优先，默认探测）"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "文本": "识别出的文本（词级数据为 false 时）",
          "词列表": "词级数据列表（词级数据为 true 时，每项含 文本/置信度/坐标）"
        }
      },
      "错误码": [
        "参数不合法",
        "文件不存在",
        "工具缺失",
        "语言包缺失",
        "识别失败",
        "进程崩溃",
        "超时",
        "取消",
        "超出限制",
        "命令失败",
        "版本不兼容",
        "提供者不可用"
      ],
      "调用示例": {
        "能力id": "OCR.识别图片文字",
        "参数": {
          "语言": "eng",
          "词级数据": false,
