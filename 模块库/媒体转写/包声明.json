{
  "包id": "模块库.媒体转写",
  "名称": "媒体转写",
  "类型": "模块",
  "版本": "1.0.0",
  "说明": "组合 FFmpeg 与 MLX Whisper 支持库公开入口：视频自动提取音频后转写、音频转写、可用性检查；未配置模型如实返回，不伪造转写成功。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "FFmpeg媒体.提取音频",
      "版本": ">=1.0.0"
    },
    {
      "能力": "转写.检查可用性",
      "版本": ">=1.0.0"
    },
    {
      "能力": "转写.转写音频文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "转写.获取模型版本",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "媒体转写.转写视频文件",
      "名称": "转写视频文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        },
        {
          "名称": "输出格式",
          "类型": "文本"
        },
        {
          "名称": "提取超时秒",
          "类型": "数字"
        },
        {
          "名称": "转写超时秒",
          "类型": "数字"
        },
        {
          "名称": "取消判断",
          "类型": "任意"
        },
        {
          "名称": "配置",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "视频自动提取音频后转写；未配置模型如实返回 未配置模型"
    },
    {
      "能力id": "媒体转写.转写音频文件",
      "名称": "转写音频文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        },
        {
          "名称": "超时秒",
          "类型": "数字"
        },
        {
          "名称": "取消判断",
          "类型": "任意"
        },
        {
          "名称": "配置",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "转写音频文件为文本（经 MLX Whisper 受管子进程）"
    },
    {
      "能力id": "媒体转写.检查可用性",
      "名称": "检查可用性",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "数字"
        },
        {
          "名称": "配置",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "检查转写可用性；模型未配置如实返回 未配置模型"
    },
    {
      "能力id": "媒体转写.获取模型版本",
      "名称": "获取模型版本",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "数字"
        },
        {
          "名称": "配置",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "获取 MLX Whisper 模型与库版本"
    }
  ]
}
