          "名称": "配置",
          "类型": "字典",
          "必填": false,
          "默认值": null,
          "说明": "模型配置（模型路径/模型名）；缺省读环境变量"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "文本": "文本",
          "语言": "文本",
          "模型名": "文本"
        }
      },
      "错误码": [
        "参数不合法",
