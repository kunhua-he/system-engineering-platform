{
  "包id": "模块库.直播逐字稿",
  "名称": "直播逐字稿",
  "类型": "功能模块",
  "版本": "1.0.0",
  "说明": "直播逐字稿模块（功能模块）：组合 媒体处理支持库(ffmpeg探测)/转写支持库(MLX Whisper) 公开能力，传视频或音频绝对路径即产出带时间戳的原始逐字稿文件；未配置模型如实返回 未配置模型；调用方统一走 获取能力调用器().调用能力。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "媒体处理支持库.FFmpeg媒体.探测媒体",
      "版本": ">=1.0.0"
    },
    {
      "能力": "媒体处理支持库.FFmpeg媒体.检查提供者",
      "版本": ">=1.0.0"
    },
    {
      "能力": "转写支持库.转写.转写音频文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "转写支持库.转写.检查可用性",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "直播逐字稿.转写媒体文件",
      "名称": "转写媒体文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本型"
        },
        {
          "名称": "输出目录",
          "类型": "文本型"
        },
        {
          "名称": "分片秒数",
          "类型": "整型"
        },
        {
          "名称": "重叠秒数",
          "类型": "整型"
        },
        {
          "名称": "模型配置",
          "类型": "字典型"
        },
        {
          "名称": "附加术语",
          "类型": "文本型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "转写直播媒体文件为原始逐字稿（探测→转写→落盘）"
    },
    {
      "能力id": "直播逐字稿.检查可用性",
      "名称": "检查可用性",
      "参数": [
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        },
        {
          "名称": "配置",
          "类型": "字典型"
        }
      ],
      "返回": "结果型",
      "说明": "检查直播逐字稿链路可用性（媒体探测/转写模型）"
    },
    {
      "能力id": "直播逐字稿.读取项目状态",
      "名称": "读取项目状态",
      "参数": [
        {
          "名称": "输出目录",
          "类型": "文本型"
        }
      ],
      "返回": "结果型",
      "说明": "读取逐字稿项目状态（断点续跑查询）"
    }
  ]
}
