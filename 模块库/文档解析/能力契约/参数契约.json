{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "文档解析.解析文档",
      "版本": "1.0.0",
      "说明": "按格式解析文档为平台通用文档：doc/docx/xls/xlsx/ppt/pptx/pdf（大小写与点前缀自动归一化）；旧格式经 LibreOffice 转换链组合解析",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待解析文件绝对路径"
        },
        {
          "名称": "格式",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "doc/docx/xls/xlsx/ppt/pptx/pdf"
        },
        {
          "名称": "资源预算",
          "类型": "整数",
          "必填": false,
          "默认值": 209715200,
          "说明": "最大文件字节数"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": {
            "文档类型": "文本",
            "格式": "文本",
            "标题": "文本",
            "块列表": "列表",
            "资源列表": "列表",
            "保真级别": "文本",
            "解析方式": "文本",
            "警告": "列表",
            "诊断": "列表",
            "原始文件摘要": "文本"
          }
        }
      },
      "错误码": [
        "参数不合法",
        "文件不存在",
        "提供者不可用",
        "文件损坏",
        "文件加密",
        "超出限制",
        "转换失败",
        "超时"
      ],
      "调用示例": {
        "能力id": "文档解析.解析文档",
        "参数": {
          "文件路径": "/tmp/示例文档.docx",
          "格式": "docx"
        }
      }
    }
  ]
}
