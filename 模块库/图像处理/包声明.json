{
  "包id": "模块库.图像处理",
  "名称": "图像处理",
  "类型": "模块",
  "版本": "1.0.0",
  "说明": "组合 Pillow 提供者公开入口：分析图像文件（解码+尺寸+像素统计一次返回）、生成占位图（纯色/渐变/文本）、按内容识别格式（伪装检测）。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "图像解码.解码图像",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.像素统计",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.生成占位图",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "图像处理.分析图像文件",
      "名称": "分析图像文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "读取图像文件并一次返回解码+像素统计：{格式, 宽度, 高度, 模式, 像素数, 平均颜色{红,绿,蓝}}；错误码透传 Pillow 提供者"
    },
    {
      "能力id": "图像处理.生成占位图",
      "名称": "生成占位图",
      "参数": [
        {
          "名称": "宽度",
          "类型": "任意"
        },
        {
          "名称": "高度",
          "类型": "任意"
        },
        {
          "名称": "占位类型",
          "类型": "任意"
        },
        {
          "名称": "背景颜色",
          "类型": "任意"
        },
        {
          "名称": "前景颜色",
          "类型": "任意"
        },
        {
          "名称": "文本",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "生成占位图（纯色/渐变/文本）PNG：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.识别图像格式",
      "名称": "识别图像格式",
      "参数": [
        {
          "名称": "字节",
          "类型": "任意"
        }
      ],
      "返回": "结果",
      "说明": "按内容识别图像格式（伪装检测）：返回 {格式, 宽度, 高度, 模式}；内容非图像 → 格式未知"
    }
  ]
}
