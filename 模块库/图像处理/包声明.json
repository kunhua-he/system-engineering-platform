{
  "包id": "模块库.图像处理",
  "名称": "图像处理",
  "类型": "基础模块",
  "版本": "1.2.0",
  "说明": "组合 Pillow 提供者公开入口：分析图像文件（解码+尺寸+像素统计一次返回）、生成占位图（纯色/渐变/文本）、按内容识别格式（伪装检测）、生成缩略图、图像EXIF转置、透明背景合成、计算感知哈希、缩放图像、重编码图像。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "文件系统支持库.文件操作.读取二进制文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.解码图像",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.像素统计",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.生成占位图",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.生成缩略图",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.图像EXIF转置",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.透明背景合成",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.计算感知哈希",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.缩放图像",
      "版本": ">=1.0.0"
    },
    {
      "能力": "图像解码.重编码图像",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "图像处理.分析图像文件",
      "名称": "分析图像文件",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本型"
        },
        {
          "名称": "相对路径",
          "类型": "文本型"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型"
        }
      ],
      "返回": "结果型",
      "说明": "在受控根目录内读取图像文件并一次返回解码+像素统计：{格式, 宽度, 高度, 模式, 像素数, 平均颜色{红,绿,蓝}}；错误码透传 文件系统/图像解码 支持库"
    },
    {
      "能力id": "图像处理.生成占位图",
      "名称": "生成占位图",
      "参数": [
        {
          "名称": "宽度",
          "类型": "整数型"
        },
        {
          "名称": "高度",
          "类型": "整数型"
        },
        {
          "名称": "占位类型",
          "类型": "文本型"
        },
        {
          "名称": "背景颜色",
          "类型": "文本型"
        },
        {
          "名称": "前景颜色",
          "类型": "文本型"
        },
        {
          "名称": "文本",
          "类型": "文本型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "生成占位图（纯色/渐变/文本）PNG：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.识别图像格式",
      "名称": "识别图像格式",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "按内容识别图像格式（伪装检测）：返回 {格式, 宽度, 高度, 模式}；内容非图像 → 格式未知"
    },
    {
      "能力id": "图像处理.生成缩略图",
      "名称": "生成缩略图",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "最大边长",
          "类型": "整数型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "按最大边长生成等比例缩略图（只缩不放大）：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.图像EXIF转置",
      "名称": "图像EXIF转置",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "按 EXIF orientation 转置图像方向（无方向时原样返回）：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.透明背景合成",
      "名称": "透明背景合成",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "背景颜色",
          "类型": "文本型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "透明图像与背景色合成（输出 RGB PNG）：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.计算感知哈希",
      "名称": "计算感知哈希",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "哈希类型",
          "类型": "文本型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "计算感知哈希（aHash/dHash/pHash）：返回 {哈希, 哈希类型}"
    },
    {
      "能力id": "图像处理.缩放图像",
      "名称": "缩放图像",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "宽度",
          "类型": "整数型"
        },
        {
          "名称": "高度",
          "类型": "整数型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "按指定宽高缩放（宽高可空=最长边按纵横比推算）：返回 {图像b64, 格式, 宽度, 高度}"
    },
    {
      "能力id": "图像处理.重编码图像",
      "名称": "重编码图像",
      "参数": [
        {
          "名称": "字节",
          "类型": "字节集型"
        },
        {
          "名称": "格式",
          "类型": "文本型"
        },
        {
          "名称": "质量",
          "类型": "整数型"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型"
        }
      ],
      "返回": "结果型",
      "说明": "按格式与质量重编码图像（JPEG/PNG/WebP）：返回 {图像b64, 格式, 宽度, 高度}"
    }
  ]
}
