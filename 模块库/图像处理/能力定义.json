{
  "包id": "模块库.图像处理",
  "版本": "1.2.2",
  "说明": "组合 Pillow 提供者公开入口：分析图像文件（解码+尺寸+像素统计一次返回）、生成占位图（纯色/渐变/文本）、按内容识别格式（伪装检测）、生成缩略图、图像EXIF转置、透明背景合成、计算感知哈希、缩放图像、重编码图像。",
  "能力列表": [
    {
      "能力id": "图像处理.分析图像文件",
      "版本": "1.0.0",
      "中文名称": "分析图像文件",
      "说明": "在受控根目录内读取图像文件并一次返回解码+像素统计：{格式, 宽度, 高度, 模式, 像素数, 平均颜色{红,绿,蓝}}；读取/解码/统计错误码透传支持库层",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "文件读取的受控根目录（目录不存在 → 目录不存在）"
        },
        {
          "名称": "相对路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "根目录内相对路径（越出根目录 → 路径越界；不存在 → 文件不存在）"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false,
          "默认值": 0,
          "说明": "读取字节上限，0 表示不限制（超限 → 文件超限）"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "格式": "文本型",
          "宽度": "整数型",
          "高度": "整数型",
          "模式": "文本型",
          "像素数": "整数型",
          "平均颜色": {
            "红": "整数型",
            "绿": "整数型",
            "蓝": "整数型"
          }
        }
      },
      "错误码": [
        "参数不合法",
        "目录不存在",
        "路径越界",
        "文件不存在",
        "文件超限",
        "文件读取失败",
        "超大",
        "格式未知",
        "文件损坏",
        "超时",
        "提供者崩溃",
        "提供者不可用"
      ],
      "行为": {
        "修改输入": false,
        "幂等": true,
        "副作用": "只读",
        "排序稳定": true,
        "时区": "不涉及",
        "编码": "utf-8",
        "精度": "不涉及",
        "空值": "按参数契约处理",
        "输入上限": "由资源预算约束",
        "超时可重试": false,
