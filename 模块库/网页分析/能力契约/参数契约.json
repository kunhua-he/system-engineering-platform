{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "网页分析.提取网页信息",
      "版本": "1.0.0",
      "说明": "组合提取网页标题与正文：经 网页解析.提取网页标题/提取网页正文 能力调用，返回 结果(值={标题, 正文})；正文剔除 script/style、空白归一化、截断到 最大长度。",
      "参数": [
        {
          "名称": "网页内容",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "HTML 网页内容字符串"
        },
        {
          "名称": "最大长度",
          "类型": "整数",
          "必填": false,
          "默认值": 20000,
          "说明": "正文最大长度（默认 20000）"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "值": {"标题": "文本", "正文": "文本"},
          "成功": "布尔",
          "错误": "错误结构"
        }
      },
      "错误码": ["参数不合法", "提供者不可用"],
      "调用示例": {
        "能力id": "网页分析.提取网页信息",
        "参数": {
          "网页内容": "<html><head><title>示例标题</title></head><body><p>示例正文</p></body></html>",
          "最大长度": 20000
        }
      }
    }
  ]
}
