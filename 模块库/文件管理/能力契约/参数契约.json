{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "文件管理.读取文件",
      "版本": "1.0.0",
      "说明": "读取文本文件（默认 utf-8），返回 结果[文本]",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待读取文件绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "文本"
        }
      },
      "错误码": ["文件不存在", "文件读取失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.读取文件",
        "参数": {
          "文件路径": "模块库/文件管理/说明/使用说明.md"
        }
      }
    },
    {
      "能力id": "文件管理.写入文件",
      "版本": "1.0.0",
      "说明": "写入文本文件（默认 utf-8，自动创建父目录），返回 结果",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "目标文件绝对路径"
        },
        {
          "名称": "内容",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待写入文本内容"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "空"
        }
      },
      "错误码": ["文件不可写", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.写入文件",
        "参数": {
          "文件路径": "工程缓存/合规_文件管理/写入.txt",
          "内容": "文件管理模块合规写入"
        }
      }
    },
    {
      "能力id": "文件管理.复制文件",
      "版本": "1.0.0",
      "说明": "复制文件到目标路径（自动创建父目录），返回 结果",
      "参数": [
        {
          "名称": "源路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "源文件绝对路径"
        },
        {
          "名称": "目标路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "目标文件绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "空"
        }
      },
      "错误码": ["文件不存在", "文件复制失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.复制文件",
        "参数": {
          "源路径": "模块库/文件管理/说明/使用说明.md",
          "目标路径": "工程缓存/合规_文件管理/复制.txt"
        }
      }
    },
    {
      "能力id": "文件管理.移动文件",
      "版本": "1.0.0",
      "说明": "移动文件到目标路径（自动创建父目录），返回 结果",
      "参数": [
        {
          "名称": "源路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "源文件绝对路径"
        },
        {
          "名称": "目标路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "目标文件绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "空"
        }
      },
      "错误码": ["文件不存在", "文件移动失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.移动文件",
        "参数": {
          "源路径": "工程缓存/合规_文件管理/写入.txt",
          "目标路径": "工程缓存/合规_文件管理/移动.txt"
        }
      }
    },
    {
      "能力id": "文件管理.删除文件",
      "版本": "1.0.0",
      "说明": "删除文件（不存在视为成功，幂等），返回 结果",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待删除文件绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "空"
        }
      },
      "错误码": ["文件删除失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.删除文件",
        "参数": {
          "文件路径": "工程缓存/合规_文件管理/删除.txt"
        }
      }
    },
    {
      "能力id": "文件管理.列出文件",
      "版本": "1.0.0",
      "说明": "列出目录下条目名称（排序），返回 结果[名称列表]",
      "参数": [
        {
          "名称": "目录路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待列出目录绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "列表"
        }
      },
      "错误码": ["目录不存在", "目录读取失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.列出文件",
        "参数": {
          "目录路径": "模块库/文件管理"
        }
      }
    },
    {
      "能力id": "文件管理.读取二进制文件",
      "版本": "1.0.0",
      "说明": "在受控根目录内按相对路径读取二进制文件（路径越界拒绝、超限拒绝），返回 结果[字节]",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "受控根目录绝对路径"
        },
        {
          "名称": "相对路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "根目录内相对路径（不得越界）"
        },
        {
          "名称": "最大字节数",
          "类型": "整数",
          "必填": false,
          "默认值": 0,
          "说明": "超过该字节数拒绝读取；0 表示不限制"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "字节"
        }
      },
      "错误码": ["路径越界", "文件超限", "文件不存在", "目录不存在", "文件读取失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.读取二进制文件",
        "参数": {
          "受控根目录": "模块库/文件管理",
          "相对路径": "说明/使用说明.md",
          "最大字节数": 0
        }
      }
    },
    {
      "能力id": "文件管理.读取文件头部字节",
      "版本": "1.0.0",
      "说明": "在受控根目录内按相对路径只读文件头部 N 字节（不加载全文件），返回 结果[字节]",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "受控根目录绝对路径"
        },
        {
          "名称": "相对路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "根目录内相对路径（不得越界）"
        },
        {
          "名称": "字节数",
          "类型": "整数",
          "必填": false,
          "默认值": 4096,
          "说明": "只读头部字节数"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "字节"
        }
      },
      "错误码": ["路径越界", "文件不存在", "目录不存在", "文件读取失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.读取文件头部字节",
        "参数": {
          "受控根目录": "模块库/文件管理",
          "相对路径": "说明/使用说明.md",
          "字节数": 8
        }
      }
    },
    {
      "能力id": "文件管理.流式创建摘要",
      "版本": "1.0.0",
      "说明": "大文件分块流式创建内容摘要（sha256），返回 结果[摘要文本]",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "待摘要文件绝对路径"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "成功": "布尔",
          "值": "文本"
        }
      },
      "错误码": ["文件不存在", "摘要失败", "提供者不可用"],
      "调用示例": {
        "能力id": "文件管理.流式创建摘要",
        "参数": {
          "文件路径": "模块库/文件管理/说明/使用说明.md"
        }
      }
    }
  ]
}
