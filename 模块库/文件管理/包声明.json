{
  "包id": "模块库.文件管理",
  "名称": "文件管理",
  "类型": "基础模块",
  "版本": "2.0.0",
  "说明": "组合文件系统与资源管理支持库：读取、写入、复制、移动、删除、列出、受控二进制读取、头部读取、流式摘要。",
  "入口": "__init__.py",
  "依赖": [
    {
      "能力": "文件系统.读取文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.写入文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.复制文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.移动文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.删除文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.列出目录",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.读取二进制文件",
      "版本": ">=1.0.0"
    },
    {
      "能力": "文件系统.读取文件头部字节",
      "版本": ">=1.0.0"
    },
    {
      "能力": "资源管理.创建内容摘要",
      "版本": ">=1.0.0"
    }
  ],
  "能力": [
    {
      "能力id": "文件管理.读取文件",
      "名称": "读取文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "读取文本文件（默认 utf-8），返回 结果[文本]"
    },
    {
      "能力id": "文件管理.写入文件",
      "名称": "写入文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        },
        {
          "名称": "内容",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "写入文本文件（默认 utf-8，自动创建父目录）"
    },
    {
      "能力id": "文件管理.复制文件",
      "名称": "复制文件",
      "参数": [
        {
          "名称": "源路径",
          "类型": "文本"
        },
        {
          "名称": "目标路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "复制文件到目标路径（自动创建父目录）"
    },
    {
      "能力id": "文件管理.移动文件",
      "名称": "移动文件",
      "参数": [
        {
          "名称": "源路径",
          "类型": "文本"
        },
        {
          "名称": "目标路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "移动文件到目标路径（自动创建父目录）"
    },
    {
      "能力id": "文件管理.删除文件",
      "名称": "删除文件",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "删除文件（不存在视为成功，幂等）"
    },
    {
      "能力id": "文件管理.列出文件",
      "名称": "列出文件",
      "参数": [
        {
          "名称": "目录路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "列出目录下条目名称（排序），返回 结果[名称列表]"
    },
    {
      "能力id": "文件管理.读取二进制文件",
      "名称": "读取二进制文件",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本"
        },
        {
          "名称": "相对路径",
          "类型": "文本"
        },
        {
          "名称": "最大字节数",
          "类型": "整数"
        }
      ],
      "返回": "结果",
      "说明": "受控根内读取二进制文件（路径越界拒绝、超限拒绝）"
    },
    {
      "能力id": "文件管理.读取文件头部字节",
      "名称": "读取文件头部字节",
      "参数": [
        {
          "名称": "受控根目录",
          "类型": "文本"
        },
        {
          "名称": "相对路径",
          "类型": "文本"
        },
        {
          "名称": "字节数",
          "类型": "整数"
        }
      ],
      "返回": "结果",
      "说明": "受控根内只读文件头部 N 字节"
    },
    {
      "能力id": "文件管理.流式创建摘要",
      "名称": "流式创建摘要",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本"
        }
      ],
      "返回": "结果",
      "说明": "大文件分块流式创建内容摘要（sha256），返回 结果[摘要文本]"
    }
  ]
}
