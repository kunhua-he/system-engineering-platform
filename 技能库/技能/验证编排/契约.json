{
  "能力标识": "技能.验证编排",
  "名称": "验证编排",
  "分类": "验证",
  "版本": "1.1.0",
  "执行入口": "脚本执行器",
  "路径": "验证编排",
  "参数": [
    {
      "名称": "名称",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "本次验证的名称，写进账本"
    },
    {
      "名称": "命令",
      "类型": "列表型",
      "必填": true,
      "默认值": null,
      "说明": "验证命令数组；只允许底座唯一白名单三形态（精确 unittest 模块 / HTML 黑盒验证器 / 唯一发布入口），形态与实存由底座能力 测试支持库.验证命令白名单 判（本技能不再自持副本）"
    },
    {
      "名称": "退出码",
      "类型": "整数型",
      "必填": true,
      "默认值": null,
      "说明": "验证命令真实执行后的退出码（由调用方经底座能力执行后回传）"
    },
    {
      "名称": "项目根目录",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "白名单实存校验与相对路径解析的根（绝对路径）"
    },
    {
      "名称": "开工id",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "开工标识；必须已有 MCP 使用反馈记录才允许记账"
    },
    {
      "名称": "标准输出",
      "类型": "文本型",
      "必填": false,
      "默认值": "",
      "说明": "验证命令真实执行后的标准输出（判定零测试/收集错误/未解释跳过/缓存假绿/导入失败当跳过的证据，口径＝底座能力 测试支持库.验证结果判定）"
    },
    {
      "名称": "标准错误",
      "类型": "文本型",
      "必填": false,
      "默认值": "",
      "说明": "验证命令真实执行后的标准错误"
    },
    {
      "名称": "反馈路径",
      "类型": "文本型",
      "必填": false,
      "默认值": "",
      "说明": "MCP 使用反馈 jsonl 路径（空=项目根目录/开发文档/项目证据/MCP使用反馈.jsonl；相对路径按项目根目录解析）"
    },
    {
      "名称": "账本路径",
      "类型": "文本型",
      "必填": false,
      "默认值": "",
      "说明": "验证账本 jsonl 路径（空=判定通过也只回记录不落盘；相对路径按项目根目录解析）"
    },
    {
      "名称": "超时秒数",
      "类型": "整数型",
      "必填": false,
      "默认值": 300,
      "说明": "执行验证命令时的超时上限（只记账，执行由调用方做）"
    },
    {
      "名称": "指纹参数",
      "类型": "字典型",
      "必填": false,
      "默认值": null,
      "说明": "账本指纹补充：{提交, 工作区指纹, 指纹}；留空则三项为空串（技能脚本不起进程，git 指纹由调用方给）"
    },
    {
      "名称": "发布参数",
      "类型": "字典型",
      "必填": false,
      "默认值": null,
      "说明": "唯一发布命令时组装发布证据请求：{提交, 工作区指纹, 制品摘要, 来源指纹, 能力覆盖, 场景覆盖, 真实结果}"
    },
    {
      "名称": "记账时间",
      "类型": "文本型",
      "必填": false,
      "默认值": "",
      "说明": "账本时间戳（留空=取当前 UTC 时间；填写值原样入账，用于确定性验证用例）"
    }
  ],
  "返回": "字典型"
}
