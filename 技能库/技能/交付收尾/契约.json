{
  "能力标识": "技能.交付收尾",
  "名称": "交付收尾",
  "分类": "交付",
  "版本": "1.1.0",
  "执行入口": "脚本执行器",
  "路径": "交付收尾",
  "参数": [
    {
      "名称": "开工id",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "16 位十六进制开工id（协作状态主键 work_id）"
    },
    {
      "名称": "五件套路径",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "交付证据/五件套路径，原样写入收口记录"
    },
    {
      "名称": "结论",
      "类型": "文本型",
      "必填": true,
      "默认值": null,
      "说明": "收口结论，原样写入收口记录"
    },
    {
      "名称": "项目根目录",
      "类型": "文本型",
      "必填": false,
      "默认值": null,
      "说明": "输入路径解析根与证据指纹计算根；默认当前工作目录（受控执行工作目录）。两份库的落点不经本参数决定"
    },
    {
      "名称": "反馈文件",
      "类型": "文本型",
      "必填": false,
      "默认值": null,
      "说明": "MCP反馈 JSONL 路径；默认 <项目根>/开发文档/项目证据/MCP使用反馈.jsonl"
    },
    {
      "名称": "验证历史文件",
      "类型": "文本型",
      "必填": false,
      "默认值": null,
      "说明": "验证证据 JSONL 路径；默认 <项目根>/开发文档/项目证据/验证历史.jsonl"
    },
    {
      "名称": "释放资源",
      "类型": "逻辑型",
      "必填": false,
      "默认值": true,
      "说明": "是否在写终态后释放该开工id 的文件租约与能力租约，默认释放"
    },
    {
      "名称": "运行库路径",
      "类型": "文本型",
      "必填": false,
      "默认值": null,
      "说明": "隔离用：底座运行库路径（技能验证夹具/临时库试跑）；不传即由底座能力按平台唯一解析器定位"
    },
    {
      "名称": "控制面库路径",
      "类型": "文本型",
      "必填": false,
      "默认值": null,
      "说明": "隔离用：平台控制面权威状态库路径（技能验证夹具/临时库试跑）；不传即由底座能力按平台唯一解析器定位"
    }
  ],
  "返回": "字典型"
}
