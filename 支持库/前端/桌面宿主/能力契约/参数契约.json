          "默认值": "底座桌面窗口",
          "说明": "窗口标题。"
        },
        {
          "名称": "初始文本",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "窗口初始文本。"
        },
        {
          "名称": "调用函数",
          "类型": "句柄型",
          "必填": false,
          "默认值": null,
          "说明": "收到文本后的底座回调。"
        },
        {
          "名称": "受管验证",
          "类型": "逻辑型",
          "必填": false,
