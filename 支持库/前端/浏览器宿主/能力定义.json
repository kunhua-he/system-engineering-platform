{
  "包id": "支持库.前端.浏览器宿主",
  "版本": "1.0.6",
  "说明": "标准库静态网页宿主；页面执行统一转发到 HTTP 网关。",
  "能力列表": [
    {
      "能力id": "浏览器宿主.启动网页服务",
      "版本": "1.1.0",
      "中文名称": "启动网页服务",
      "说明": "启动静态网页宿主；页面执行统一转发到 POST /网关/调用。",
      "参数": [
        {
          "名称": "标题",
          "类型": "文本型",
          "必填": false,
          "默认值": "底座网页服务",
          "说明": "网页标题。"
        },
        {
          "名称": "页面说明",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "页面说明文本。"
        },
        {
          "名称": "网关地址",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "统一 HTTP 网关地址；为空时页面只展示不执行。"
        },
        {
          "名称": "能力id",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "页面提交到统一网关的能力 id。"
        },
        {
          "名称": "端口",
          "类型": "整数型",
          "必填": false,
          "默认值": 45080,
          "说明": "本地静态页面监听端口。"
        },
        {
          "名称": "自动打开",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "是否自动拉起浏览器。"
        },
        {
          "名称": "受管验证",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "绑定可回收端口并在返回前关闭服务。"
        },
        {
          "名称": "状态目录",
          "类型": "文本型",
          "必填": false,
          "默认值": "工程缓存/浏览器宿主",
          "说明": "受管验证状态文件目录。缺省落 `工程缓存/浏览器宿主`（豁免前缀，平台自管握手件、无读取方）—— 缺省空串会解析成进程 cwd，网关 cwd 在仓库根时即受管路径而拿不到写租约。"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "值": "服务句柄与地址；受管验证时为可序列化回收结果"
        }
      },
      "错误码": [
        "参数不合法",
        "宿主不可用"
      ],
      "行为": {
        "修改输入": false,
        "幂等": true,
        "副作用": "前端描述构造或宿主受管操作",
        "排序稳定": true,
        "时区": "不涉及",
        "编码": "utf-8",
        "精度": "不涉及",
        "空值": "按参数契约处理",
        "输入上限": "由资源预算约束",
        "超时可重试": false,
        "取消": "不支持",
        "重试条件": "无",
        "事务边界": "单次调用",
        "补偿动作": "无",
        "线程安全": true,
        "进程安全": true,
        "资源释放": "按句柄或宿主生命周期",
        "错误码": "统一",
        "可重试性": "参数错误不可重试"
      },
      "提供者": {
        "默认": "支持库.前端.浏览器宿主",
        "版本": ">=1.0.0"
      }
    }
  ]
}
