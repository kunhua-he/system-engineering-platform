{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "资源描述.创建资源描述",
      "版本": "1.0.0",
      "说明": "创建平台无关资源描述字典：资源id、资源类型、来源与引用计数",
      "参数": [
        {
          "名称": "资源id",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "资源唯一标识"
        },
        {
          "名称": "资源类型",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "资源类型，如 图片/音频/文档"
        },
        {
          "名称": "来源",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "资源来源描述（可为空文本）"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "资源id": "文本",
          "资源类型": "文本",
          "来源": "文本",
          "引用计数": "整数"
        }
      },
      "错误码": ["参数不合法", "内部错误"],
      "调用示例": {
        "能力id": "资源描述.创建资源描述",
        "参数": {"资源id": "示例资源", "资源类型": "图片", "来源": "示例来源"}
      }
    },
    {
      "能力id": "资源描述.校验资源引用",
      "版本": "1.0.0",
      "说明": "校验资源描述字典的引用完整性（必填字段非空）",
      "参数": [
        {
          "名称": "资源描述",
          "类型": "字典",
          "必填": true,
          "默认值": null,
          "说明": "待校验的资源描述字典"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "完整": "布尔"
        }
      },
      "错误码": ["参数不合法", "资源引用不完整", "内部错误"],
      "调用示例": {
        "能力id": "资源描述.校验资源引用",
        "参数": {"资源描述": {"资源id": "示例资源", "资源类型": "图片", "来源": "示例来源", "引用计数": 0}}
      }
    }
  ]
