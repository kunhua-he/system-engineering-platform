{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "状态描述.创建窗口状态",
      "版本": "1.0.0",
      "说明": "创建平台无关窗口状态字典：窗口id、初始状态与空流转记录",
      "参数": [
        {
          "名称": "窗口id",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "窗口唯一标识"
        },
        {
          "名称": "初始状态",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "初始状态，合法值为 关闭/打开/最小化/最大化"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "窗口id": "文本",
          "状态": "文本",
          "流转记录": "列表"
        }
      },
      "错误码": ["参数不合法", "内部错误"],
      "调用示例": {
        "能力id": "状态描述.创建窗口状态",
        "参数": {"窗口id": "示例窗口", "初始状态": "关闭"}
      }
    },
    {
      "能力id": "状态描述.状态流转校验",
      "版本": "1.0.0",
      "说明": "校验窗口状态流转是否合法（按允许流转表判断）",
      "参数": [
        {
          "名称": "当前状态",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "当前状态，合法值为 关闭/打开/最小化/最大化"
        },
        {
          "名称": "目标状态",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "目标状态，合法值为 关闭/打开/最小化/最大化"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "合法": "布尔"
        }
      },
      "错误码": ["参数不合法", "状态流转不合法", "内部错误"],
      "调用示例": {
        "能力id": "状态描述.状态流转校验",
        "参数": {"当前状态": "关闭", "目标状态": "打开"}
      }
    }
  ]
}
