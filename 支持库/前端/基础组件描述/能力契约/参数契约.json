{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "基础组件描述.创建组件定义",
      "版本": "1.0.0",
      "说明": "创建平台无关组件定义字典：组件id、组件类型、属性与空事件列表",
      "参数": [
        {
          "名称": "组件id",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "组件唯一标识"
        },
        {
          "名称": "组件类型",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "组件类型，如 按钮/输入框"
        },
        {
          "名称": "属性",
          "类型": "字典",
          "必填": true,
          "默认值": null,
          "说明": "组件属性字典（键值对）"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "组件id": "文本",
          "组件类型": "文本",
          "属性": "字典",
          "事件列表": "列表"
        }
      },
      "错误码": ["参数不合法", "内部错误"],
      "调用示例": {
        "能力id": "基础组件描述.创建组件定义",
        "参数": {"组件id": "示例按钮", "组件类型": "按钮", "属性": {"标签": "点击"}}
      }
    },
    {
      "能力id": "基础组件描述.校验组件属性",
      "版本": "1.0.0",
      "说明": "校验组件定义字典的属性结构合法性（必填字段与属性类型）",
      "参数": [
        {
          "名称": "组件定义",
          "类型": "字典",
          "必填": true,
          "默认值": null,
          "说明": "待校验的组件定义字典"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "有效": "布尔"
        }
      },
      "错误码": ["参数不合法", "内部错误"],
      "调用示例": {
        "能力id": "基础组件描述.校验组件属性",
        "参数": {"组件定义": {"组件id": "示例按钮", "组件类型": "按钮", "属性": {"标签": "点击"}, "事件列表": []}}
      }
    },
    {
      "能力id": "基础组件描述.声明事件",
      "版本": "1.0.0",
      "说明": "向组件定义追加事件声明并返回新定义（事件列表自动去重）",
      "参数": [
        {
          "名称": "组件定义",
          "类型": "字典",
          "必填": true,
          "默认值": null,
          "说明": "组件定义字典"
        },
        {
          "名称": "事件名称",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "要声明的事件名称"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "组件id": "文本",
          "组件类型": "文本",
          "属性": "字典",
          "事件列表": "列表"
        }
      },
      "错误码": ["参数不合法", "内部错误"],
      "调用示例": {
        "能力id": "基础组件描述.声明事件",
        "参数": {"组件定义": {"组件id": "示例按钮", "组件类型": "按钮", "属性": {"标签": "点击"}, "事件列表": []}, "事件名称": "点击"}
      }
    }
  ]
}
