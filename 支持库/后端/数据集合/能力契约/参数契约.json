      ],
      "返回": {"类型": "结果", "值结构": {"值": "匹配条目索引（未找到为 -1）"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "数据集合.列表查找", "参数": {"列表": [10, 20], "目标": 20}}
