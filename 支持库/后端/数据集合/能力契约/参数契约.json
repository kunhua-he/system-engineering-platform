        {"名称": "直接匹配", "类型": "布尔", "必填": false, "默认值": false, "说明": "为真时按元素本身排序"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "排序后的新列表"}},
      "错误码": ["参数不合法"],
