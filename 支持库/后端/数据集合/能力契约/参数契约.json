    {
      "能力id": "数据集合.列表添加",
      "版本": "1.0.0",
      "说明": "追加条目并返回新列表（原列表不变），返回 {值=新列表}",
      "参数": [
        {"名称": "列表", "类型": "列表", "必填": true, "默认值": null, "说明": "源列表"},
        {"名称": "条目", "类型": "文本", "必填": true, "默认值": null, "说明": "要追加的条目（文本/整数/浮点数/布尔/字典/列表等可序列化值）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "追加后的新列表"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "数据集合.列表添加", "参数": {"列表": ["甲"], "条目": "乙"}}
    },
    {
      "能力id": "数据集合.列表移除",
      "版本": "1.0.0",
