        {"名称": "直接匹配", "类型": "布尔", "必填": false, "默认值": false, "说明": "为真时忽略字段名直接比较元素"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "过滤后的新列表"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "数据集合.过滤", "参数": {"列表": [{"名称": "甲"}, {"名称": "乙"}], "字段名": "名称", "等于值": "甲", "直接匹配": false}}
    },
    {
      "能力id": "数据集合.映射转换",
      "版本": "1.0.0",
