      "调用示例": {"能力id": "数据集合.集合取交集", "参数": {"集合甲": [1, 2], "集合乙": [2, 3]}}
    },
    {
      "能力id": "数据集合.统计数量",
      "版本": "1.0.0",
      "说明": "返回列表条目数量，返回 {值=数量}",
      "参数": [
        {"名称": "列表", "类型": "列表", "必填": true, "默认值": null, "说明": "源列表"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "条目数量（整数）"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "数据集合.统计数量", "参数": {"列表": [1, 2, 3]}}
    },
    {
      "能力id": "数据集合.按字段查找",
      "版本": "1.0.0",
      "说明": "按字段查找第一个匹配项（未找到返回空），返回 {值=匹配项或空}",
      "参数": [
        {"名称": "列表", "类型": "列表", "必填": true, "默认值": null, "说明": "字典项目列表"},
