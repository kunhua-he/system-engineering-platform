    {
      "能力id": "数据集合.按字段排序",
      "版本": "1.0.0",
      "说明": "按字段或元素排序并返回新列表，返回 {值=排序后的新列表}",
      "参数": [
        {"名称": "列表", "类型": "列表", "必填": true, "默认值": null, "说明": "字典项目列表（直接匹配时为可比较元素列表）"},
        {"名称": "字段名", "类型": "文本", "必填": true, "默认值": null, "说明": "排序字段名（直接匹配时忽略）"},
