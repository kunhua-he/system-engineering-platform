        {"名称": "匹配值", "类型": "文本", "必填": true, "默认值": null, "说明": "期望的字段值"},
        {"名称": "直接匹配", "类型": "布尔", "必填": false, "默认值": false, "说明": "为真时忽略字段名直接比较元素"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "第一个匹配项（未找到为空）"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "数据集合.按字段查找", "参数": {"列表": [{"名称": "甲"}], "字段名": "名称", "匹配值": "甲", "直接匹配": false}}
    },
    {
      "能力id": "数据集合.过滤",
      "版本": "1.0.0",
      "说明": "按字段过滤返回新列表，返回 {值=过滤后的新列表}",
