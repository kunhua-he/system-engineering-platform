{
  "包id": "支持库.后端.文件系统支持库.内容检索",
  "版本": "1.1.2",
  "说明": "按正则表达式搜索目录内文件内容（优先 rg，回退 grep）",
  "能力列表": [
    {
      "能力id": "文件系统支持库.内容检索.正则搜索",
      "版本": "1.0.0",
      "中文名称": "正则搜索",
      "说明": "按正则搜索目录内文件内容（优先 rg，回退 grep）；返回 {引擎, 搜索根, 匹配列表, 匹配数, 已达上限, 命令}",
      "参数": [
        {
          "名称": "根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "搜索根目录（绝对路径）"
        },
        {
          "名称": "模式",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "正则表达式"
        },
        {
          "名称": "路径",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "相对根目录的子路径"
        },
        {
          "名称": "文件模式",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "文件名通配"
        },
        {
          "名称": "最大匹配数",
          "类型": "整数型",
          "必填": false,
          "默认值": 30,
          "说明": "上限（硬上限 200）"
        },
        {
          "名称": "上下文",
          "类型": "整数型",
          "必填": false,
          "默认值": 0,
          "说明": "上下文行数 0-3"
        },
        {
          "名称": "忽略大小写",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "默认 假"
        },
        {
          "名称": "排除列表",
          "类型": "列表型",
          "必填": false,
          "默认值": null,
          "说明": "排除项；不传用默认噪声目录表"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "引擎": "实际使用的检索引擎（rg 或 grep）",
          "搜索根": "相对根目录的搜索起点（根目录本身为 .）",
          "匹配列表": "列表，每项 {文件, 行号, 文本}",
          "匹配数": "匹配条数（整数）",
          "已达上限": "匹配数是否达到上限（逻辑型）",
          "命令": "实际执行的命令列表"
        }
      },
      "错误码": [
        "参数不合法",
        "目录不存在",
        "超时",
        "执行失败",
        "检索失败"
      ],
      "行为": {
        "修改输入": false,
        "幂等": true,
        "副作用": "只读（调用 rg/grep 子进程，不写入任何文件）",
        "排序稳定": true,
        "时区": "不涉及",
        "编码": "utf-8",
        "精度": "不涉及",
        "空值": "根目录/模式为空 → 参数不合法；排除列表不传用默认噪声目录表，传空列表表示不排除",
        "输入上限": "最大匹配数 1-200（默认 30）；上下文 0-3；子进程超时 60 秒",
        "超时可重试": true,
        "取消": "不支持",
        "重试条件": "超时",
        "事务边界": "无",
        "补偿动作": "无",
        "线程安全": true,
        "进程安全": true,
        "资源释放": "子进程由 subprocess.run 同步结束并回收，无句柄残留",
        "错误码": "统一",
        "可重试性": "参数错误不可重试；超时可重试"
      },
      "提供者": {
        "默认": "支持库.后端.文件系统支持库.内容检索",
        "版本": ">=1.0.0"
      }
    }
  ]
}
