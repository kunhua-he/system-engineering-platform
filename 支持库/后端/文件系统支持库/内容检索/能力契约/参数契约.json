{
  "包id": "支持库.后端.文件系统支持库.内容检索",
  "契约版本": "1.1.0",
  "能力契约": [
    {
      "能力id": "文件系统支持库.内容检索.正则搜索",
      "版本": "1.0.0",
      "中文名称": "正则搜索",
      "说明": "按正则搜索目录内文件内容（优先 rg，回退 grep）",
      "参数": [
        {
          "名称": "根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "搜索根目录（绝对路径）"
        },
        {
          "名称": "模式",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "正则表达式"
        },
        {
          "名称": "路径",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "相对根目录的子路径"
        },
        {
          "名称": "文件模式",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "文件名通配"
        },
        {
          "名称": "最大匹配数",
          "类型": "整数型",
          "必填": false,
          "默认值": 30,
          "说明": "上限（硬上限 200）"
        },
        {
          "名称": "上下文",
          "类型": "整数型",
          "必填": false,
          "默认值": 0,
          "说明": "上下文行数 0-3"
        },
        {
          "名称": "忽略大小写",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "默认 假"
        },
        {
          "名称": "排除列表",
          "类型": "列表型",
          "必填": false,
          "默认值": null,
          "说明": "排除项"
        }
      ]
    }
  ]
}
