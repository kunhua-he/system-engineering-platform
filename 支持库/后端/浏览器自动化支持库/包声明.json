{
  "包id": "支持库.后端.浏览器自动化支持库",
  "名称": "浏览器自动化支持库",
  "类型": "支持库",
  "版本": "1.3.0",
  "说明": "受管浏览器会话原子能力；Provider独立进程运行，句柄和资源由底座治理。",
  "入口": "__init__.py",
  "依赖": [],
  "句柄超时秒": 1800,
  "能力": [
    {
      "能力id": "浏览器自动化.创建会话",
      "名称": "创建会话",
      "参数": [
        {
          "名称": "会话模式",
          "类型": "文本型",
          "必填": false,
          "默认值": "临时",
          "说明": ""
        },
        {
          "名称": "授权标识",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": ""
        },
        {
          "名称": "超时秒",
          "类型": "整数型",
          "必填": false,
          "默认值": 30,
          "说明": ""
        },
        {
          "名称": "视口宽",
          "类型": "整数型",
          "必填": false,
          "默认值": 0,
          "说明": "浏览器视口宽度（0 表示用浏览器默认）"
        },
        {
          "名称": "视口高",
          "类型": "整数型",
          "必填": false,
          "默认值": 0,
          "说明": "浏览器视口高度（0 表示用浏览器默认）"
        }
      ],
      "返回": "结果型",
      "版本": "1.1.0",
      "说明": "创建浏览器会话并返回句柄；支持指定视口宽高（0 表示用浏览器默认）"
    },
    {
      "能力id": "浏览器自动化.导航页面",
      "名称": "导航页面",
      "参数": [
        {
          "名称": "句柄",
          "类型": "整数型",
          "必填": true
        },
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true
        },
        {
          "名称": "超时秒",
          "类型": "整数型",
          "必填": false
        }
      ],
      "返回": "结果型"
    },
    {
      "能力id": "浏览器自动化.读取页面",
      "名称": "读取页面",
      "参数": [
        {
          "名称": "句柄",
          "类型": "整数型",
          "必填": true
        },
        {
          "名称": "内容类型",
          "类型": "文本型",
          "必填": false
        },
        {
          "名称": "最大长度",
          "类型": "整数型",
          "必填": false
        }
      ],
      "返回": "结果型",
      "说明": "读取页面内容：内容类型支持 文本 / HTML / 链接（链接返回可见链接清单）"
    },
    {
      "能力id": "浏览器自动化.页面操作",
      "名称": "页面操作",
      "参数": [
        {
          "名称": "句柄",
          "类型": "整数型",
          "必填": true
        },
        {
          "名称": "操作",
          "类型": "文本型",
          "必填": true
        },
        {
          "名称": "选择器",
          "类型": "文本型",
          "必填": false
        },
        {
          "名称": "文本",
          "类型": "文本型",
          "必填": false
        },
        {
          "名称": "超时秒",
          "类型": "整数型",
          "必填": false
        }
      ],
      "返回": "结果型"
    },
    {
      "能力id": "浏览器自动化.获取截图",
      "名称": "获取截图",
      "参数": [
        {
          "名称": "句柄",
          "类型": "整数型",
          "必填": true
        },
        {
          "名称": "格式",
          "类型": "文本型",
          "必填": false
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false
        }
      ],
      "返回": "结果型"
    },
    {
      "能力id": "浏览器自动化.关闭会话",
      "名称": "关闭会话",
      "参数": [
        {
          "名称": "句柄",
          "类型": "整数型",
          "必填": true
        }
      ],
      "返回": "结果型"
    },
    {
      "能力id": "浏览器自动化.读取截图",
      "名称": "读取截图",
      "参数": [
        {
          "名称": "资源句柄",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "获取截图 返回的资源句柄"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false,
          "默认值": 20971520,
          "说明": "可读取的最大字节数"
        }
      ],
      "返回": "结果型",
      "说明": "读取截图资源内容（截图句柄由本支持库创建，故由本支持库解析）；二进制经 base64 返回"
    }
  ]
}
