{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "PDF文档.解析PDF",
      "版本": "1.0.0",
      "说明": "解析 PDF 为平台通用文档（文本/表格/图像，经 PDF隔离提供者 隔离子进程执行），返回 结果[通用文档]",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "PDF 文件路径（不存在返回 文件不存在）"},
        {"名称": "最大页数", "类型": "整数", "必填": false, "默认值": 500, "说明": "页数上限，超限返回 超出限制；0=不限制"},
        {"名称": "最大字节数", "类型": "整数", "必填": false, "默认值": 209715200, "说明": "文件大小上限（字节），超限返回 超出限制；0=不限制"},
        {"名称": "超时秒", "类型": "数字", "必填": false, "默认值": 60, "说明": "解析软超时（秒），超时返回 超时；0=不限制"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "通用文档（块列表/资源列表/元数据）"}},
      "错误码": ["参数不合法", "文件不存在", "超出限制", "文件损坏", "文件加密", "提供者不可用", "提供者崩溃", "超时"],
      "调用示例": {"能力id": "PDF文档.解析PDF", "参数": {"文件路径": "示例/文档.pdf", "最大页数": 500, "最大字节数": 209715200, "超时秒": 60}}
    }
  ]
}
