{
  "包id": "支持库.后端.技能库",
  "名称": "技能库",
  "类型": "支持库",
  "版本": "1.0.0",
  "说明": "技能库：技能包结构校验、受控脚本执行、技能索引扫描。技能是给 Agent 消费的可复用工作流，不另开 HTTP 入口，走底座唯一执行入口。",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "技能库.技能包.校验技能包",
      "名称": "校验技能包",
      "参数": [
        {
          "名称": "技能根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能根目录绝对路径（须含 索引.json）"
        },
        {
          "名称": "技能标识或路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能能力标识，或技能根目录下的相对目录路径"
        }
      ],
      "返回": "结果型",
      "说明": "校验技能包六件套结构（SKILL.md/契约.json/工作流.json/依赖.json/验证声明.json/scripts）是否齐全，返回 {通过, 技能目录, 来源, 缺失}"
    },
    {
      "能力id": "技能库.受控执行.运行技能包",
      "名称": "运行技能包",
      "参数": [
        {
          "名称": "技能根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能根目录绝对路径"
        },
        {
          "名称": "能力标识",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能能力标识（须在 索引.json 登记）"
        },
        {
          "名称": "参数",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "传给技能脚本的参数对象（经 stdin JSON）"
        },
        {
          "名称": "超时秒",
          "类型": "整数型",
          "必填": false,
          "默认值": 30,
          "说明": "脚本执行超时秒数"
        },
        {
          "名称": "输出上限",
          "类型": "整数型",
          "必填": false,
          "默认值": 1048576,
          "说明": "stdout 字节上限"
        },
        {
          "名称": "环境变量",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "仅白名单内变量可覆盖"
        },
        {
          "名称": "禁止导入前缀",
          "类型": "列表型",
          "必填": false,
          "默认值": null,
          "说明": "调用方追加的禁入模块前缀（项目级边界）"
        },
        {
          "名称": "项目根目录",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "脚本工作目录，默认取技能根目录"
        }
      ],
      "返回": "结果型",
      "说明": "受控执行技能包：结构校验→定位入口→AST 导入审计→沙箱运行（进程组回收/超时/输出上限/环境白名单/资源预算），返回技能脚本结果"
    },
    {
      "能力id": "技能库.技能索引.扫描技能包",
      "名称": "扫描技能包",
      "参数": [
        {
          "名称": "技能根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能根目录绝对路径"
        }
      ],
      "返回": "结果型",
      "说明": "扫描技能索引登记的技能包，返回 {数量, 技能列表}，逐项标注结构是否完整"
    },
    {
      "能力id": "技能库.技能索引.生成索引",
      "名称": "生成索引",
      "参数": [
        {
          "名称": "技能根目录",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "技能根目录绝对路径"
        },
        {
          "名称": "写回索引",
          "类型": "逻辑型",
          "必填": false,
          "默认值": true,
          "说明": "是否写回 索引.json"
        }
      ],
      "返回": "结果型",
      "说明": "扫描技能根目录下全部技能包，从各自 契约.json 派生索引条目，并可选写回 索引.json（参数事实唯一源仍是契约）"
    }
  ]
}
