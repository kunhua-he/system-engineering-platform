   "敏感": false,
   "说明": "单文件大小上限",
   "错误码": "超出限制"
  },
  {
   "配置名称": "默认超时秒",
   "类型": "整数型",
   "必填": false,
   "默认值": 60,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "外部转换默认超时",
   "错误码": "超时"
  }
 ]
}