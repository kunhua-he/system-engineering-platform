{
  "包id": "支持库.后端.办公文档支持库.PDF文档",
  "版本": "2.0.0",
  "说明": "PDF 文档解析原子能力：pdfplumber 提取文本/表格/图像坐标，PyMuPDF(fitz) 检测加密与渲染图像字节，返回平台通用文档结果；损坏/加密/超限/提供者缺失均返回稳定错误码。",
  "能力列表": [
    {
      "能力id": "办公文档支持库.PDF文档.解析PDF",
      "版本": "2.0.0",
      "中文名称": "解析PDF",
      "说明": "解析 PDF 为平台通用文档（文本/表格/图像，经 PDF隔离提供者 隔离子进程执行），返回 结果[通用文档]",
      "参数": [
        {
          "名称": "文件路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "PDF 文件路径（不存在返回 文件不存在）"
        },
        {
          "名称": "最大页数",
          "类型": "整数型",
          "必填": false,
          "默认值": 500,
          "说明": "页数上限，超限返回 超出限制；0=不限制"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false,
          "默认值": 209715200,
          "说明": "文件大小上限（字节），超限返回 超出限制；0=不限制"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 60,
          "说明": "解析软超时（秒），超时返回 超时；0=不限制"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "值": "通用文档（块列表/资源列表/元数据）"
        }
      },
      "错误码": [
        "参数不合法",
        "文件不存在",
        "超出限制",
        "文件损坏",
        "文件加密",
        "提供者不可用",
        "提供者崩溃",
        "超时"
      ],
      "行为": {
        "修改输入": false,
        "幂等": true,
        "副作用": "只读",
        "排序稳定": true,
        "时区": "不涉及",
        "编码": "utf-8",
        "精度": "不涉及",
        "空值": "按参数契约处理",
        "输入上限": "由资源预算约束",
        "超时可重试": false,
        "取消": "不支持",
        "重试条件": "无",
        "事务边界": "无",
        "补偿动作": "无",
        "线程安全": true,
        "进程安全": true,
        "资源释放": "按句柄生命周期自动释放",
        "错误码": "统一",
        "可重试性": "参数错误不可重试"
      },
      "提供者": {
        "默认": "支持库.后端.办公文档支持库.PDF文档",
        "版本": ">=1.0.0"
      }
    }
  ],
  "迁移来源": {
    "参数契约": "能力契约/参数契约.json",
    "包声明": "包声明.json",
