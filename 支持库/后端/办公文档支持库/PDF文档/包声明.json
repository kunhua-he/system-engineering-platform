{
 "包id": "支持库.后端.办公文档支持库.PDF文档",
 "名称": "PDF文档",
 "类型": "支持库",
 "版本": "1.0.3",
 "说明": "PDF 文档解析原子能力：pdfplumber 提取文本/表格/图像坐标，PyMuPDF(fitz) 检测加密与渲染图像字节，返回平台通用文档结果；损坏/加密/超限/提供者缺失均返回稳定错误码。",
 "入口": "__init__.py",
 "依赖": [
  {
   "能力": "文档转换支持库.PDF隔离提供者.解析PDF",
   "版本": ">=1.0.0"
  }
 ],
 "能力": [
  {
   "能力id": "办公文档支持库.PDF文档.解析PDF",
   "名称": "解析PDF",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "最大页数",
     "类型": "整数型"
    },
    {
     "名称": "最大字节数",
     "类型": "整数型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "值": "通用文档（块列表/资源列表/元数据）"
    }
   },
   "说明": "解析 PDF 为平台通用文档（文本/表格/图像，经 PDF隔离提供者 隔离子进程执行），返回 结果[通用文档]"
  }
 ],
 "配置项": [
  {
   "配置名称": "默认最大页数",
   "类型": "整数型",
   "必填": false,
   "默认值": 500,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "解析 PDF 的页数上限，超限返回 超出限制",
   "错误码": "超出限制"
  },
  {
   "配置名称": "默认最大字节数",
   "类型": "整数型",
   "必填": false,
   "默认值": 209715200,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "PDF 文件大小上限（字节），超限返回 超出限制",
   "错误码": "超出限制"
  },
  {
   "配置名称": "默认超时秒",
   "类型": "双精度数型",
   "必填": false,
   "默认值": 60,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "解析软超时（秒），超时返回 超时",
   "错误码": "超时"
  }
 ]
}