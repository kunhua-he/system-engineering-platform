{
  "契约版本": "验证场景/v1",
  "验证场景": [
    {
      "场景id": "模板渲染.两能力正向HTTP",
      "前置步骤": [
        {
          "步骤id": "前置读取模板夹具",
          "能力id": "文件系统支持库.文件操作.读取文件",
          "参数": {
            "文件路径": {
              "$动态": "夹具文件复制",
              "来源": "夹具/最小模板.txt",
              "目标": "模板渲染/最小模板.txt"
            },
            "编码": "utf-8"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "关键值": {
                                "$": "你好，{{姓名}}！编号：{{编号}}。"
              },
              "值类型": "文本型",
              "包含": "{{姓名}}"
            }
          }
        }
      ],
      "目标步骤": [
        {
          "步骤id": "目标渲染模板",
          "能力id": "办公文档支持库.模板渲染.渲染模板",
          "参数": {
            "模板": {
              "$动态": "步骤返回",
              "步骤id": "前置读取模板夹具",
              "JSON路径": "$.值"
            },
            "变量": {
              "姓名": "小马仔",
              "编号": 17
            },
            "缺失行为": "报错"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "关键值": {
                "渲染结果": "你好，小马仔！编号：17。",
                "变量数": 2
              },
              "必需字段": [
                "渲染结果",
                "变量数"
              ],
              "字段类型": {
                "渲染结果": "文本型",
                "变量数": "整数型"
              }
            }
          }
        },
        {
          "步骤id": "目标提取变量名",
          "能力id": "办公文档支持库.模板渲染.提取变量名",
          "参数": {
            "模板": {
              "$动态": "步骤返回",
              "步骤id": "前置读取模板夹具",
              "JSON路径": "$.值"
            }
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "关键值": {
                "变量名列表": [
                  "姓名",
                  "编号"
                ]
              },
              "字段类型": {
                "变量名列表": "列表型"
              }
            }
          }
        }
      ],
      "清理步骤": [
        {
          "步骤id": "finally删除模板夹具",
          "能力id": "文件系统支持库.文件操作.删除文件",
          "参数": {
            "文件路径": {
              "$动态": "步骤返回",
              "步骤id": "前置读取模板夹具",
              "JSON路径": "$.参数.文件路径"
            }
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值": true
            }
          }
        }
      ]
    }
  ]
}
