{
  "包id": "支持库.后端.办公文档支持库.表格公式",
  "名称": "表格公式",
  "类型": "支持库",
  "版本": "1.0.0",
  "说明": "表格公式原子能力：Excel 公式求值（AST 白名单，禁 eval）与 A1 单元格地址/范围运算。纯标准库，无状态。",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "办公文档支持库.表格公式.求值公式",
      "名称": "求值公式",
      "参数": [
        {
          "名称": "表达式",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "公式文本，可带 = 前缀"
        },
        {
          "名称": "单元格字典",
          "类型": "字典型",
          "必填": true,
          "默认值": null,
          "说明": "地址 → 文本值（如 {'A1': '3'}）"
        }
      ],
      "返回": "结果型",
      "说明": "对 Excel 公式求值：非 = 开头原样返回；支持 SUM/AVERAGE/COUNT/MAX/MIN 与四则运算，AST 白名单求值禁用 eval；错误值沿用 Excel 语义（#VALUE!/#DIV/0!/#NAME?）"
    },
    {
      "能力id": "办公文档支持库.表格公式.解析单元格地址",
      "名称": "解析单元格地址",
      "参数": [
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "单元格地址，如 A1/AB12"
        }
      ],
      "返回": "结果型",
      "说明": "解析 A1 样式地址为行列：行 1 起、列 0 起；非法地址返回 0/0（与旧实现一致）"
    },
    {
      "能力id": "办公文档支持库.表格公式.格式化单元格地址",
      "名称": "格式化单元格地址",
      "参数": [
        {
          "名称": "行",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "行号（1 起）"
        },
        {
          "名称": "列",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "列号（0 起）"
        }
      ],
      "返回": "结果型",
      "说明": "把（行 1 起、列 0 起）格式化为 A1 样式地址"
    },
    {
      "能力id": "办公文档支持库.表格公式.格式化列字母",
      "名称": "格式化列字母",
      "参数": [
        {
          "名称": "列",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "列号（0 起）"
        }
      ],
      "返回": "结果型",
      "说明": "把列序号（0 起）格式化为列字母：0 → A、26 → AA"
    },
    {
      "能力id": "办公文档支持库.表格公式.列字母转索引",
      "名称": "列字母转索引",
      "参数": [
        {
          "名称": "列字母",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "列字母文本"
        }
      ],
      "返回": "结果型",
      "说明": "把列字母转为列序号（0 起）：A → 0、AA → 26"
    },
    {
      "能力id": "办公文档支持库.表格公式.解析单元格范围",
      "名称": "解析单元格范围",
      "参数": [
        {
          "名称": "范围",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "范围文本，如 A1:B3"
        }
      ],
      "返回": "结果型",
      "说明": "解析 'A1:B3' 为四角行列；非两段写法按单地址处理（左上右下相同）"
    },
    {
      "能力id": "办公文档支持库.表格公式.展开单元格范围",
      "名称": "展开单元格范围",
      "参数": [
        {
          "名称": "范围",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "范围文本，如 A1:C3"
        }
      ],
      "返回": "结果型",
      "说明": "把 'A1:C3' 展开为范围内全部单元格地址（先行后列）"
    },
    {
      "能力id": "办公文档支持库.表格公式.批量格式化单元格地址",
      "名称": "批量格式化单元格地址",
      "参数": [
        {
          "名称": "行列列表",
          "类型": "列表型",
          "必填": true,
          "默认值": null,
          "说明": "行列对列表，每项包含 行（1 起）与 列（0 起）两个整数"
        }
      ],
      "返回": "结果型",
      "说明": "把 (行,列) 列表批量格式化为 A1 样式地址，返回与输入同序同长的地址列表；逐项复用 格式化单元格地址，非法项语义与单次调用完全一致，供调用方把循环内逐格转换外提为一次调用"
    }
  ]
}
