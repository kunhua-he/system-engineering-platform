    {
      "能力id": "办公文档支持库.文档生成.生成PPTX",
      "名称": "生成PPTX",
      "参数": [
        {
          "名称": "参数",
          "类型": "字典型"
        }
      ],
      "返回": "结果型",
      "说明": "按幻灯片列表（标题/要点/备注）生成 PPTX，返回 结果[生成产物]"
    },
    {
      "能力id": "办公文档支持库.文档生成.生成PDF",
      "名称": "生成PDF",
      "参数": [
        {
          "名称": "参数",
          "类型": "字典型"
        }
      ],
      "返回": "结果型",
      "说明": "按内容块列表生成 PDF（中文 STSong/PingFang 注册），返回 结果[生成产物]"
    },
    {
      "能力id": "办公文档支持库.文档生成.校验签名",
      "名称": "校验签名",
      "参数": [
        {
          "名称": "格式",
          "类型": "文本型"
        },
        {
          "名称": "字节",
          "类型": "字典型"
        }
      ],
      "返回": "结果型",
      "说明": "校验生成产物签名：OOXML 有效 ZIP 且含必要成员；PDF 头尾完整且可重新打开"
    },
    {
      "能力id": "办公文档支持库.文档生成.合并文本文件",
      "名称": "合并文本文件",
      "说明": "合并多个文本文件到输出文件",
      "参数": [
        {
          "名称": "文件列表",
          "类型": "列表型",
          "必填": true,
          "默认值": null,
          "说明": "文本文件路径列表"
        },
        {
          "名称": "输出路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "输出文件路径"
        },
        {
          "名称": "分隔符",
          "类型": "文本型",
          "必填": false,
          "默认值": "\\n",
          "说明": "文件间分隔符"
