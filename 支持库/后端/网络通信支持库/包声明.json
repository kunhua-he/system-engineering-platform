{
  "包id": "支持库.后端.网络通信支持库",
  "名称": "网络通信支持库",
  "类型": "支持库",
  "版本": "2.0.2",
  "说明": "聚合支持库，包含 3 个子域：出站安全/网页解析/请求",
  "入口": "__init__.py",
  "句柄超时秒": 1800,
  "依赖": [],
  "能力": [
    {
      "能力id": "网络通信支持库.出站安全.校验出站URL",
      "名称": "校验出站URL",
      "说明": "出站 URL 的 SSRF 防护：拒绝私有/内网/回环/保留/云元数据地址，可选 DNS 解析后逐地址判定",
      "参数": [
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "待校验的出站 URL（http/https）"
        },
        {
          "名称": "解析DNS",
          "类型": "逻辑型",
          "必填": false,
          "默认值": true,
          "说明": "是否对主机名做 DNS 解析后逐地址判定；关闭时仅按字面主机名判定"
        },
        {
          "名称": "DNS超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 10.0,
          "说明": "DNS 解析超时（仅 解析DNS=true 时生效）"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "允许": "逻辑型",
          "原因": "文本型",
          "地址": "文本型"
        }
      },
      "错误码": "参数不合法"
    },
    {
      "能力id": "网络通信支持库.网页解析.提取网页标题",
      "名称": "提取网页标题",
      "说明": "从 HTML 内容中提取 <title> 标签文本并去除首尾空白；无标题时返回空字符串",
      "参数": [
        {
          "名称": "网页内容",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "HTML 内容字符串"
        }
      ],
      "返回": "结果型",
      "错误码": "参数不合法,解析失败"
    },
    {
      "能力id": "网络通信支持库.网页解析.提取网页正文",
      "名称": "提取网页正文",
      "说明": "从 HTML 内容中提取 body 文本：剔除 script/style 标签内容，空白归一化，截断到 最大长度",
      "参数": [
        {
          "名称": "网页内容",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "HTML 内容字符串"
        },
        {
          "名称": "最大长度",
          "类型": "整数型",
          "必填": false,
          "默认值": 20000,
          "说明": "正文最大字符数"
        }
      ],
      "返回": "结果型",
      "错误码": "参数不合法,解析失败"
    },
    {
      "能力id": "网络通信支持库.请求.发送请求",
      "名称": "发送请求",
      "说明": "发送 HTTP 请求，适配主流场景：GET/POST/PUT/DELETE/PATCH/HEAD/OPTIONS、JSON/表单/原始字节、自定义请求头/Cookie、代理、SSL验证开关、重定向控制、超时/SSRF防护/响应上限",
      "参数": [
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "目标地址 http/https"
        },
        {
          "名称": "方法",
          "类型": "文本型",
          "必填": false,
          "默认值": "GET",
          "说明": "GET/POST/PUT/DELETE/PATCH/HEAD/OPTIONS"
        },
        {
          "名称": "请求头",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "自定义请求头 {键:值}"
        },
        {
          "名称": "请求体",
          "类型": "JSON值型",
          "必填": false,
          "默认值": null,
          "说明": "请求体：dict(自动JSON)/str/bytes"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 10,
          "说明": "连接/读取统一超时"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false,
          "默认值": 5242880,
          "说明": "响应大小上限，超限中止"
        },
        {
          "名称": "允许回环",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "是否允许访问回环地址（本机测试用）"
        },
        {
          "名称": "代理",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "代理地址 http://127.0.0.1:端口"
        },
        {
          "名称": "SSL验证",
          "类型": "逻辑型",
          "必填": false,
          "默认值": null,
          "说明": "false 跳过 SSL 证书验证"
        },
        {
          "名称": "跟随重定向",
          "类型": "逻辑型",
          "必填": false,
          "默认值": null,
          "说明": "false 禁止自动重定向"
        },
        {
          "名称": "Cookie",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "Cookie 字符串（可选）"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "状态码": "整数型",
          "响应头": "字典型",
          "响应文本": "文本型",
          "错误信息": "文本型"
        }
      },
      "错误码": "参数不合法,响应超限,网络超时,网络失败,HTTP错误"
    },
    {
      "能力id": "网络通信支持库.请求.上传文件",
      "名称": "上传文件",
      "说明": "multipart/form-data 上传本地文件",
      "参数": [
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "上传目标地址"
        },
        {
          "名称": "文件路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "本地文件绝对路径"
        },
        {
          "名称": "字段名",
          "类型": "文本型",
          "必填": false,
          "默认值": "file",
          "说明": "表单字段名"
        },
        {
          "名称": "额外字段",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "额外表单字段 {键:值}"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 10,
          "说明": "超时"
        },
        {
          "名称": "允许回环",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "允许回环"
        },
        {
          "名称": "代理",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "代理地址"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "状态码": "整数型",
          "响应头": "字典型",
          "响应文本": "文本型"
        }
      },
      "错误码": "参数不合法,超出限制,上传失败,响应超限,网络超时,网络失败,HTTP错误"
    },
    {
      "能力id": "网络通信支持库.请求.下载文件",
      "名称": "下载文件",
      "说明": "从 URL 流式下载文件到本地（适配大文件）",
      "参数": [
        {
          "名称": "地址",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "下载地址"
        },
        {
          "名称": "保存路径",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "本地保存路径"
        },
        {
          "名称": "请求头",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "自定义请求头"
        },
        {
          "名称": "超时秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 10,
          "说明": "超时"
        },
        {
          "名称": "允许回环",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "允许回环"
        },
        {
          "名称": "代理",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "代理地址"
        },
        {
          "名称": "SSL验证",
          "类型": "逻辑型",
          "必填": false,
          "默认值": null,
          "说明": "false 跳过 SSL 验证"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "状态码": "整数型",
          "文件路径": "文本型",
          "字节数": "整数型"
        }
      },
      "错误码": "参数不合法,响应超限,下载失败,网络超时"
    },
    {
      "能力id": "网络通信支持库.请求.构建查询串",
      "名称": "构建查询串",
      "说明": "把参数映射编码为 URL 查询串",
      "参数": [
        {
          "名称": "参数",
