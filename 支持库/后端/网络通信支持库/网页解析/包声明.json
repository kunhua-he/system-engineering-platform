{
  "包id": "支持库.后端.网络通信支持库.网页解析",
  "名称": "网页解析",
  "类型": "支持库",
  "版本": "2.0.0",
  "说明": "原子网页解析能力：提取网页标题与网页正文。仅用 Python 标准库 html.parser，不依赖任何第三方。",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "网络通信支持库.网页解析.提取网页标题",
      "名称": "提取网页标题",
      "参数": [
        {
          "名称": "网页内容",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "HTML 内容字符串"
        }
      ],
      "返回": "结果型",
      "说明": "从 HTML 内容中提取 <title> 标签文本并去除首尾空白；无标题时返回空字符串"
    },
    {
      "能力id": "网络通信支持库.网页解析.提取网页正文",
      "名称": "提取网页正文",
      "参数": [
        {
          "名称": "网页内容",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "HTML 内容字符串"
        },
        {
          "名称": "最大长度",
          "类型": "整数型",
          "必填": false,
          "默认值": 20000,
          "说明": "正文最大字符数"
        }
      ],
      "返回": "结果型",
      "说明": "从 HTML 内容中提取 body 文本：剔除 script/style 标签内容，空白归一化，截断到 最大长度"
    }
  ]
}
