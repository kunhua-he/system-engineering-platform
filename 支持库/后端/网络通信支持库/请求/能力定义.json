{
  "包id": "支持库.后端.网络通信支持库.请求",
  "版本": "2.0.0",
  "说明": "网络请求原子能力：HTTP 客户端适配所有主流场景（方法/请求头/代理/SSL/重定向/Cookie/文件上传/文件下载），SSRF 防护",
  "能力列表": [
    {
      "能力id": "网络通信支持库.请求.发送请求",
      "名称": "发送请求",
      "说明": "发送 HTTP 请求，适配主流场景：GET/POST/PUT/DELETE/PATCH/HEAD/OPTIONS、JSON/表单/原始字节、自定义请求头/Cookie、代理、SSL验证开关、重定向控制、超时/SSRF防护/响应上限",
      "参数": [
        {"名称": "地址", "类型": "文本型", "必填": true, "默认值": null, "说明": "目标地址 http/https"},
        {"名称": "方法", "类型": "文本型", "必填": false, "默认值": "GET", "说明": "GET/POST/PUT/DELETE/PATCH/HEAD/OPTIONS"},
        {"名称": "请求头", "类型": "映射型", "必填": false, "默认值": null, "说明": "自定义请求头 {键:值}"},
        {"名称": "请求体", "类型": "任意型", "必填": false, "默认值": null, "说明": "请求体：dict(自动JSON)/str/bytes"},
        {"名称": "超时秒", "类型": "双精度数型", "必填": false, "默认值": 10, "说明": "连接/读取统一超时"},
        {"名称": "最大字节数", "类型": "整数型", "必填": false, "默认值": 5242880, "说明": "响应大小上限，超限中止"},
        {"名称": "允许回环", "类型": "逻辑型", "必填": false, "默认值": false, "说明": "是否允许访问回环地址（本机测试用）"},
        {"名称": "代理", "类型": "文本型", "必填": false, "默认值": null, "说明": "代理地址 http://127.0.0.1:端口"},
        {"名称": "SSL验证", "类型": "逻辑型", "必填": false, "默认值": null, "说明": "false 跳过 SSL 证书验证"},
        {"名称": "跟随重定向", "类型": "逻辑型", "必填": false, "默认值": null, "说明": "false 禁止自动重定向"},
        {"名称": "Cookie", "类型": "文本型", "必填": false, "默认值": null, "说明": "Cookie 字符串（可选）"}
      ],
      "返回": "{状态码, 响应头, 响应文本, 错误信息}",
      "错误码": "参数不合法,响应超限,网络超时,网络失败"
    },
    {
      "能力id": "网络通信支持库.请求.上传文件",
      "名称": "上传文件",
      "说明": "multipart/form-data 上传本地文件",
      "参数": [
        {"名称": "地址", "类型": "文本型", "必填": true, "默认值": null, "说明": "上传目标地址"},
        {"名称": "文件路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "本地文件绝对路径"},
        {"名称": "字段名", "类型": "文本型", "必填": false, "默认值": "file", "说明": "表单字段名"},
        {"名称": "额外字段", "类型": "映射型", "必填": false, "默认值": null, "说明": "额外表单字段 {键:值}"},
        {"名称": "超时秒", "类型": "双精度数型", "必填": false, "默认值": 10, "说明": "超时"},
        {"名称": "允许回环", "类型": "逻辑型", "必填": false, "默认值": false, "说明": "允许回环"},
        {"名称": "代理", "类型": "文本型", "必填": false, "默认值": null, "说明": "代理地址"}
      ],
      "返回": "{状态码, 响应头, 响应文本}",
      "错误码": "参数不合法,上传失败,网络超时,网络失败"
    },
    {
      "能力id": "网络通信支持库.请求.下载文件",
      "名称": "下载文件",
      "说明": "从 URL 流式下载文件到本地（适配大文件）",
      "参数": [
        {"名称": "地址", "类型": "文本型", "必填": true, "默认值": null, "说明": "下载地址"},
        {"名称": "保存路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "本地保存路径"},
        {"名称": "请求头", "类型": "映射型", "必填": false, "默认值": null, "说明": "自定义请求头"},
        {"名称": "超时秒", "类型": "双精度数型", "必填": false, "默认值": 10, "说明": "超时"},
        {"名称": "允许回环", "类型": "逻辑型", "必填": false, "默认值": false, "说明": "允许回环"},
        {"名称": "代理", "类型": "文本型", "必填": false, "默认值": null, "说明": "代理地址"},
        {"名称": "SSL验证", "类型": "逻辑型", "必填": false, "默认值": null, "说明": "false 跳过 SSL 验证"}
      ],
      "返回": "{状态码, 文件路径, 字节数}",
      "错误码": "参数不合法,下载失败,网络超时,网络失败"
    },
    {
      "能力id": "网络通信支持库.请求.构建查询串",
      "名称": "构建查询串",
      "说明": "把参数映射编码为 URL 查询串",
      "参数": [
        {"名称": "参数", "类型": "映射型", "必填": true, "默认值": null, "说明": "参数映射"}
      ],
      "返回": "{查询串}",
      "错误码": "参数不合法"
    }
  ]
}
