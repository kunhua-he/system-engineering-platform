     "说明": "进程/端口/SQLite连接/临时文件"
    },
    {
     "名称": "PID",
     "类型": "整数型",
     "必填": false,
     "默认值": null,
     "说明": "进程PID"
    },
    {
     "名称": "端口",
     "类型": "整数型",
     "必填": false,
     "默认值": null,
     "说明": "监听端口"
    },
    {
     "名称": "资源路径",
     "类型": "文本型",
     "必填": false,
     "默认值": null,
     "说明": "文件/连接路径"
    },
    {
     "名称": "清理函数名",
     "类型": "文本型",
     "必填": false,
     "默认值": null,
     "说明": "拥有方清理函数"
    }
   ],
   "返回": "结果型",
   "说明": "资源启动时登记并绑定到句柄（进程/端口/SQLite连接/临时文件）"
  },
  {
   "能力id": "资源回收确认.核查回收",
   "名称": "核查回收",
   "参数": [
    {
     "名称": "句柄",
     "类型": "文本型",
     "必填": true,
     "默认值": null,
     "说明": "句柄"
    }
   ],
