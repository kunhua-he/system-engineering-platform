  },
  {
   "能力id": "资源回收确认.查询资源",
   "名称": "查询资源",
   "参数": [
    {
     "名称": "句柄",
     "类型": "文本型",
     "必填": true,
     "默认值": null,
     "说明": "句柄"
    }
   ],
   "返回": "结果型",
   "说明": "查询句柄绑定的资源（审计）"
  }
 ],
 "句柄超时秒": 60
}