        {"名称": "模型名", "类型": "文本型", "必填": true, "默认值": null, "说明": "嵌入模型名"},
        {"名称": "提供者", "类型": "文本型", "必填": true, "默认值": null, "说明": "提供者标识"},
        {"名称": "数据库路径", "类型": "文本型", "必填": false, "默认值": null, "说明": "自定义缓存库路径"}
      ],
      "返回": "结果型",
      "说明": "查询缓存嵌入向量，命中返回 {命中=true, 向量=[...]}"
    },
    {
      "能力id": "嵌入缓存.存储嵌入",
      "名称": "存储嵌入",
