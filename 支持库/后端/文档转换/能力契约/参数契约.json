{
 "能力契约": [
  {
   "能力id": "文档转换.检查提供者",
   "参数": [
    {
     "名称": "提供者名",
     "类型": "文本",
     "必填": false,
     "说明": "textutil / libreoffice / 全部"
    }
   ],
   "返回": "结果",
   "错误码": [
    "提供者不可用"
   ]
  },
  {
   "能力id": "文档转换.转换文本文件",
   "参数": [
    {
     "名称": "源路径",
     "类型": "文本",
     "必填": true,
     "说明": "待转换文件绝对路径"
    },
    {
     "名称": "目标格式",
     "类型": "文本",
     "必填": false,
     "默认值": "txt",
     "说明": "txt / html / rtf"
    },
    {
     "名称": "输出目录",
     "类型": "文本",
     "必填": false,
     "说明": "输出目录（默认临时目录，用后释放）"
    },
    {
     "名称": "超时秒",
     "类型": "数字",
     "必填": false,
     "默认值": 60,
     "说明": "执行超时"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数",
     "必填": false,
     "默认值": 209715200,
     "说明": "输出大小上限"
    }
   ],
   "返回": "结果",
   "错误码": [
    "文件不存在",
    "参数不合法",
    "提供者不可用",
    "转换失败",
    "超时"
   ]
  },
  {
   "能力id": "文档转换.转换办公文件",
   "参数": [
    {
     "名称": "源路径",
     "类型": "文本",
     "必填": true,
     "说明": "待转换文件绝对路径"
    },
    {
     "名称": "目标格式",
     "类型": "文本",
     "必填": true,
     "说明": "pdf/docx/pptx/xlsx/txt/html/rtf/csv 等"
    },
    {
     "名称": "输出目录",
     "类型": "文本",
     "必填": false,
     "说明": "输出目录（默认源文件目录）"
    },
    {
     "名称": "超时秒",
     "类型": "数字",
     "必填": false,
     "默认值": 60,
     "说明": "执行超时"
    },
    {
     "名称": "最大输出字节",
     "类型": "整数",
     "必填": false,
     "默认值": 209715200,
     "说明": "输出大小上限"
    }
   ],
   "返回": "结果",
   "错误码": [
    "文件不存在",
    "参数不合法",
    "提供者不可用",
    "转换失败",
    "超时"
   ]
  }
 ]
}
