{
  "包id": "支持库.后端.系统核心支持库.限流",
  "名称": "限流",
  "类型": "支持库",
  "版本": "2.0.0",
  "说明": "限流支持库：令牌桶判定、请求编号生成、登录限速判定（无状态纯计算）",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "系统核心支持库.限流.令牌桶判定",
      "名称": "令牌桶判定",
      "参数": [
        {
          "名称": "桶容量",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "桶容量（正整数）"
        },
        {
          "名称": "每秒补充",
          "类型": "双精度数型",
          "必填": true,
          "默认值": null,
          "说明": "令牌补充速率（每秒，非负）"
        },
        {
          "名称": "当前令牌数",
          "类型": "双精度数型",
          "必填": true,
          "默认值": null,
          "说明": "调用方持有的当前令牌数"
        },
        {
          "名称": "上次补充时间",
          "类型": "双精度数型",
          "必填": true,
          "默认值": null,
          "说明": "调用方持有的上次补充时间（单调时钟秒）"
        },
        {
          "名称": "现在",
          "类型": "双精度数型",
          "必填": false,
          "默认值": null,
          "说明": "当前时间（省略则由能力取单调时钟）"
        },
        {
          "名称": "取用数量",
          "类型": "整数型",
          "必填": false,
          "默认值": 1,
          "说明": "本次取用令牌数"
        }
      ],
      "返回": "结果型",
      "说明": "令牌桶惰性补充与取用判定，返回 {放行, 当前令牌数, 上次补充时间}；状态由调用方持有"
    },
    {
      "能力id": "系统核心支持库.限流.生成请求编号",
      "名称": "生成请求编号",
      "参数": [
        {
          "名称": "长度",
          "类型": "整数型",
          "必填": false,
          "默认值": 8,
          "说明": "编号长度（1-32）"
        }
      ],
      "返回": "结果型",
      "说明": "生成唯一请求编号（十六进制片段），返回 {请求编号}"
    },
    {
      "能力id": "系统核心支持库.限流.登录限速判定",
      "名称": "登录限速判定",
      "参数": [
        {
          "名称": "当前失败次数",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "当前累计失败次数"
        },
        {
          "名称": "最大失败次数",
          "类型": "整数型",
          "必填": true,
          "默认值": null,
          "说明": "允许的最大失败次数（正整数）"
        },
        {
          "名称": "锁定剩余秒",
          "类型": "双精度数型",
          "必填": false,
          "默认值": 0.0,
          "说明": "仍在锁定窗口内的剩余秒数"
        }
      ],
      "返回": "结果型",
      "说明": "登录失败限速判定，返回 {锁定, 原因, 剩余可尝试次数}"
    }
  ]
}
