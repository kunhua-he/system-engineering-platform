{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "文件系统.读取文件",
      "版本": "1.0.0",
      "说明": "按文本方式读取文件内容，返回 {值=文本内容}",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要读取的文件路径（文件不存在返回 文件不存在）"},
        {"名称": "编码", "类型": "文本", "必填": false, "默认值": "utf-8", "说明": "文本编码（默认 utf-8）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "文件文本内容"}},
      "错误码": ["参数不合法", "文件不存在", "文件读取失败"],
      "调用示例": {"能力id": "文件系统.读取文件", "参数": {"文件路径": "支持库/后端/文件系统/包声明.json", "编码": "utf-8"}}
    },
    {
      "能力id": "文件系统.写入文件",
      "版本": "1.0.0",
      "说明": "按文本方式写入文件（自动创建父目录），返回 {值=true}",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "目标文件路径"},
        {"名称": "内容", "类型": "文本", "必填": true, "默认值": null, "说明": "要写入的文本内容"},
        {"名称": "编码", "类型": "文本", "必填": false, "默认值": "utf-8", "说明": "文本编码（默认 utf-8；未知编码返回 参数不合法）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "成功标志（布尔）"}},
      "错误码": ["参数不合法", "文件不可写"],
      "调用示例": {"能力id": "文件系统.写入文件", "参数": {"文件路径": "/tmp/文件系统示例/示例.txt", "内容": "示例内容", "编码": "utf-8"}}
    },
    {
      "能力id": "文件系统.判断存在",
      "版本": "1.0.0",
      "说明": "判断路径是否存在并直接返回布尔（平台既有契约：统一验证器直接消费布尔；非法参数视为不存在）",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要判断的路径（非法参数按不存在处理）"}
      ],
      "返回": {"类型": "布尔", "值结构": {"存在": "路径是否存在"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "文件系统.判断存在", "参数": {"文件路径": "支持库/后端/文件系统/包声明.json"}}
    },
    {
      "能力id": "文件系统.列出目录",
      "版本": "1.0.0",
      "说明": "列出目录下条目名称（排序稳定），返回 {值=名称列表}",
      "参数": [
        {"名称": "目录路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要列出的目录路径（目录不存在返回 目录不存在）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "条目名称列表"}},
      "错误码": ["参数不合法", "目录不存在", "目录读取失败"],
      "调用示例": {"能力id": "文件系统.列出目录", "参数": {"目录路径": "支持库/后端/文件系统"}}
    },
    {
      "能力id": "文件系统.删除文件",
      "版本": "1.0.0",
      "说明": "删除文件或空目录（不存在视为幂等成功），返回 {值=true}",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要删除的文件或空目录路径"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "成功标志（布尔）"}},
      "错误码": ["参数不合法", "文件删除失败"],
      "调用示例": {"能力id": "文件系统.删除文件", "参数": {"文件路径": "/tmp/文件系统示例/待删除示例.txt"}}
