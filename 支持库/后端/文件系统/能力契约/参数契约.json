        {"名称": "目标路径", "类型": "文本", "必填": true, "默认值": null, "说明": "目标文件路径"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "成功标志（布尔）"}},
      "错误码": ["参数不合法", "文件不存在", "文件复制失败"],
      "调用示例": {"能力id": "文件系统.复制文件", "参数": {"源路径": "支持库/后端/文件系统/包声明.json", "目标路径": "/tmp/文件系统示例/复制示例.json"}}
    },
    {
      "能力id": "文件系统.移动文件",
      "版本": "1.0.0",
      "说明": "移动文件或目录到目标路径（自动创建父目录），返回 {值=true}",
      "参数": [
        {"名称": "源路径", "类型": "文本", "必填": true, "默认值": null, "说明": "源路径（不存在返回 文件不存在）"},
        {"名称": "目标路径", "类型": "文本", "必填": true, "默认值": null, "说明": "目标路径"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "成功标志（布尔）"}},
      "错误码": ["参数不合法", "文件不存在", "文件移动失败"],
      "调用示例": {"能力id": "文件系统.移动文件", "参数": {"源路径": "/tmp/文件系统示例/不存在的源.txt", "目标路径": "/tmp/文件系统示例/移动示例.txt"}}
    },
    {
      "能力id": "文件系统.获取大小",
      "版本": "1.0.0",
      "说明": "获取文件大小（字节），返回 {值=大小}",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "文件路径（不存在返回 文件不存在）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "文件大小（整数，字节）"}},
      "错误码": ["参数不合法", "文件不存在", "文件大小读取失败"],
      "调用示例": {"能力id": "文件系统.获取大小", "参数": {"文件路径": "支持库/后端/文件系统/包声明.json"}}
    },
    {
      "能力id": "文件系统.获取修改时间",
      "版本": "1.0.0",
      "说明": "获取文件修改时间戳（秒），返回 {值=时间戳}",
      "参数": [
        {"名称": "文件路径", "类型": "文本", "必填": true, "默认值": null, "说明": "文件路径（不存在返回 文件不存在）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "修改时间戳（浮点数，秒）"}},
      "错误码": ["参数不合法", "文件不存在", "修改时间读取失败"],
      "调用示例": {"能力id": "文件系统.获取修改时间", "参数": {"文件路径": "支持库/后端/文件系统/包声明.json"}}
    },
    {
      "能力id": "文件系统.创建目录",
      "版本": "1.0.0",
      "说明": "创建目录（已存在视为幂等成功），返回 {值=true}",
      "参数": [
        {"名称": "目录路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要创建的目录路径"},
        {"名称": "递归", "类型": "布尔", "必填": false, "默认值": true, "说明": "是否递归创建父目录（默认递归）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "成功标志（布尔）"}},
      "错误码": ["参数不合法", "目录创建失败"],
      "调用示例": {"能力id": "文件系统.创建目录", "参数": {"目录路径": "/tmp/文件系统示例/示例目录", "递归": true}}
    },
    {
      "能力id": "文件系统.读取二进制文件",
      "版本": "1.0.0",
      "说明": "在受控根目录内按相对路径读取二进制文件（路径边界校验 + 大小上限），返回 {值=字节}",
      "参数": [
        {"名称": "受控根目录", "类型": "文本", "必填": true, "默认值": null, "说明": "受控根目录（不存在返回 目录不存在）"},
        {"名称": "相对路径", "类型": "文本", "必填": true, "默认值": null, "说明": "根目录内相对路径（越界返回 路径越界）"},
        {"名称": "最大字节数", "类型": "整数", "必填": false, "默认值": 0, "说明": "大小上限（0 表示不限制；超出返回 文件超限）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "文件字节内容"}},
      "错误码": ["参数不合法", "目录不存在", "路径越界", "文件不存在", "文件超限", "文件读取失败"],
      "调用示例": {"能力id": "文件系统.读取二进制文件", "参数": {"受控根目录": "支持库/后端/文件系统", "相对路径": "包声明.json", "最大字节数": 1048576}}
    },
    {
      "能力id": "文件系统.读取文件头部字节",
      "版本": "1.0.0",
      "说明": "在受控根目录内按相对路径只读文件头部 N 字节（不加载全文件），返回 {值=头部字节}",
      "参数": [
        {"名称": "受控根目录", "类型": "文本", "必填": true, "默认值": null, "说明": "受控根目录（不存在返回 目录不存在）"},
        {"名称": "相对路径", "类型": "文本", "必填": true, "默认值": null, "说明": "根目录内相对路径（越界返回 路径越界）"},
        {"名称": "字节数", "类型": "整数", "必填": false, "默认值": 4096, "说明": "要读取的头部字节数（默认 4096）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "文件头部字节"}},
      "错误码": ["参数不合法", "目录不存在", "路径越界", "文件不存在", "文件读取失败"],
      "调用示例": {"能力id": "文件系统.读取文件头部字节", "参数": {"受控根目录": "支持库/后端/文件系统", "相对路径": "包声明.json", "字节数": 128}}
    },
    {
      "能力id": "文件系统.登记临时资源",
      "版本": "1.0.0",
      "说明": "登记一个临时资源（文件或目录），由 清理全部临时资源 统一释放，返回 {值=当前登记数量}",
      "参数": [
        {"名称": "路径", "类型": "文本", "必填": true, "默认值": null, "说明": "要登记的临时资源路径（非空文本）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "当前登记数量（整数）"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "文件系统.登记临时资源", "参数": {"路径": "/tmp/文件系统示例/登记示例.txt"}}
    },
    {
      "能力id": "文件系统.清理全部临时资源",
      "版本": "1.0.0",
      "说明": "清理已登记临时资源（文件删除/目录递归删除，不存在视为幂等成功），返回 {值=清理数量}",
      "参数": [
        {"名称": "路径前缀", "类型": "文本", "必填": false, "默认值": "", "说明": "只清理路径以此前缀开头的登记资源（空串=清理全部；无匹配返回 资源不存在）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "清理数量（整数）"}},
      "错误码": ["参数不合法", "资源不存在", "清理失败"],
      "调用示例": {"能力id": "文件系统.清理全部临时资源", "参数": {"路径前缀": ""}}
    }
