{
  "契约版本": "验证场景/v1",
  "验证场景引用": [
    {
      "场景": {
        "场景id": "上下文压缩.确定性最小消息",
        "前置步骤": [],
        "目标步骤": [
          {
            "步骤id": "估算单字符",
            "能力id": "大语言模型支持库.上下文压缩.估算token数",
            "参数": {
              "文本": "a"
            },
            "预期": {
              "成功": true,
              "状态码": 200,
              "返回断言": {
                "值类型": "字典型",
                "关键值": {
                  "token数": 1,
                  "字符数": 1
                },
                "字段类型": {
                  "token数": "整数型",
                  "字符数": "整数型"
                }
              }
            }
          },
          {
            "步骤id": "估算单条消息",
            "能力id": "大语言模型支持库.上下文压缩.估算消息token数",
            "参数": {
              "消息列表": [
                {
                  "role": "user",
                  "content": "a"
                }
              ]
            },
            "预期": {
              "成功": true,
              "状态码": 200,
              "返回断言": {
                "值类型": "字典型",
                "关键值": {
                  "token数": 5,
                  "消息数": 1
                },
                "字段类型": {
                  "token数": "整数型",
                  "消息数": "整数型"
                }
              }
            }
          },
          {
            "步骤id": "压缩超阈值历史",
            "能力id": "大语言模型支持库.上下文压缩.压缩历史",
            "参数": {
              "消息列表": [
                {
                  "role": "user",
                  "content": "aaaa"
                },
                {
                  "role": "assistant",
                  "content": "b"
                }
              ],
              "压缩阈值": 5,
              "保留最近条数": 1,
              "摘要长度上限": 20,
              "摘要模式": "拼接"
            },
            "预期": {
              "成功": true,
              "状态码": 200,
              "返回断言": {
                "值类型": "字典型",
                "关键值": {
                  "已压缩": true,
                  "压缩前token": 11,
                  "压缩后token": 8,
                  "消息列表.0.role": "system",
                  "消息列表.0.content": "[历史摘要] user: aaaa",
                  "消息列表.1.role": "assistant",
                  "消息列表.1.content": "b",
                  "摘要": "user: aaaa",
                  "说明": "超阈值 5，保留最近 1 条，早期 1 条并入摘要"
                },
                "字段类型": {
                  "已压缩": "逻辑型",
                  "压缩前token": "整数型",
                  "压缩后token": "整数型",
                  "消息列表": "列表型",
                  "摘要": "文本型",
                  "说明": "文本型"
                }
              }
            }
          }
        ],
        "清理步骤": []
      }
    }
  ]
}
