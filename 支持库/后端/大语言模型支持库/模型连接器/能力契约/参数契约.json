    {
      "能力id": "大语言模型支持库.模型连接器.连接LLM",
      "版本": "1.0.0",
      "说明": "连接大语言模型，返回句柄。本地：部署形态=本地+本地路径/启动器；云端：部署形态=云端+url/api_key/模型/上下文长度。句柄默认 1800 秒无人使用自动释放；系统内存占用超阈值拒绝新连接。",
      "参数": [
        {
          "名称": "模型",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "模型名"
        },
        {
          "名称": "提供者",
          "类型": "文本型",
          "必填": false,
          "默认值": "本地",
          "说明": "提供者标识"
        },
        {
          "名称": "部署形态",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "本地/云端（默认按 url 推断）"
        },
        {
          "名称": "本地路径",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "本地模型文件路径"
        },
        {
          "名称": "启动器",
          "类型": "文本型",
          "必填": false,
          "默认值": "llama-server",
          "说明": "本地模型启动器"
        },
        {
          "名称": "模型大小字节",
          "类型": "整数型",
          "必填": false,
          "默认值": null,
          "说明": "模型文件大小（内存守卫用）"
        },
        {
          "名称": "url",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "云端端点（如 http://127.0.0.1:8328/hermes-chat/v1）"
        },
        {
          "名称": "api_key",
          "类型": "文本型",
          "必填": false,
          "默认值": null,
          "说明": "云端密钥"
        },
        {
          "名称": "上下文长度",
          "类型": "整数型",
          "必填": false,
          "默认值": null,
          "说明": "上下文窗口"
        },
        {
          "名称": "协议",
          "类型": "文本型",
          "必填": false,
          "默认值": "chat_completions",
          "说明": "请求协议：chat_completions、codex_responses 或 anthropic_messages"
        },
        {
          "名称": "额外请求头",
          "类型": "字典型",
          "必填": false,
          "默认值": null,
          "说明": "连接级静态请求头，出站时叠加在内置头之上（生成对话的 附加请求头 可覆盖同名键）"
        },
        {
          "名称": "超时秒",
          "类型": "整数型",
          "必填": false,
          "默认值": 1800,
          "说明": "无人使用自动释放秒数"
        },
        {
          "名称": "内存估算系数",
          "类型": "双精度数型",
          "必填": false,
          "默认值": null,
          "说明": "覆盖内存守卫的模型占用估算系数（默认 1.15）；按实测 RSS/模型文件大小校准，减少误拒"
        },
        {
          "名称": "内存安全阈值",
          "类型": "双精度数型",
          "必填": false,
          "默认值": null,
          "说明": "覆盖内存守卫阈值（默认 0.80）；「已用 + 模型预估 > 阈值」即拒绝新连接"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "句柄": "整数型",
          "连接类型": "文本型",
          "模型": "文本型",
          "部署形态": "文本型",
          "超时秒": "整数型"
        }
      },
