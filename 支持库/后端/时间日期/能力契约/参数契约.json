    },
    {
      "能力id": "时间日期.时间戳转换",
      "版本": "1.0.0",
      "说明": "把时间戳转换为年月日时分秒结构（Asia/Shanghai 时区），返回 {值=时间结构}",
      "参数": [
        {"名称": "时间戳", "类型": "浮点数", "必填": true, "默认值": null, "说明": "Unix 时间戳（秒）；非法时间戳返回 参数不合法"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "时间结构 {年, 月, 日, 时, 分, 秒}"}},
