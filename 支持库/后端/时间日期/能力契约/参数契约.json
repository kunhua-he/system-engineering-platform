      "参数": [
        {"名称": "时区", "类型": "文本", "必填": false, "默认值": "Asia/Shanghai", "说明": "IANA 时区名（默认 Asia/Shanghai；未知时区返回 参数不合法）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "当前时间 ISO 格式文本（含 T，秒精度）"}},
      "错误码": ["参数不合法"],
