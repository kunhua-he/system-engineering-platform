      "参数": [
        {"名称": "起始时间戳", "类型": "浮点数", "必填": true, "默认值": null, "说明": "起始时间戳（秒）"},
        {"名称": "结束时间戳", "类型": "浮点数", "必填": true, "默认值": null, "说明": "结束时间戳（秒）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "间隔秒数（浮点数）"}},
      "错误码": ["参数不合法"],
