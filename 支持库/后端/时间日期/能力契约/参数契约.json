        {"名称": "时间戳", "类型": "浮点数", "必填": true, "默认值": null, "说明": "Unix 时间戳（秒）；非法时间戳返回 参数不合法"},
        {"名称": "格式", "类型": "文本", "必填": false, "默认值": "%Y-%m-%d %H:%M:%S", "说明": "strftime 格式（默认 %Y-%m-%d %H:%M:%S）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "格式化后的时间文本"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "时间日期.格式化为文本", "参数": {"时间戳": 0, "格式": "%Y-%m-%d %H:%M:%S"}}
    },
    {
      "能力id": "时间日期.解析文本时间",
