      "参数": [
        {"名称": "文本", "类型": "文本", "必填": true, "默认值": null, "说明": "时间文本；格式不匹配返回 参数不合法"},
        {"名称": "格式", "类型": "文本", "必填": false, "默认值": "%Y-%m-%d %H:%M:%S", "说明": "strptime 格式（默认 %Y-%m-%d %H:%M:%S）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "Unix 时间戳（浮点数，秒）"}},
      "错误码": ["参数不合法"],
