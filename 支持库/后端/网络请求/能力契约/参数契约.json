{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "网络请求.发送请求",
      "版本": "1.0.0",
      "说明": "发送 HTTP GET/POST 请求（SSRF 防护：默认拒绝回环/内网/私有地址），返回 {值=状态码/响应头/响应文本/错误信息}",
      "参数": [
        {"名称": "地址", "类型": "文本", "必填": true, "默认值": null, "说明": "http/https 地址（协议白名单外或回环/内网地址返回 参数不合法）"},
        {"名称": "方法", "类型": "文本", "必填": false, "默认值": "GET", "说明": "请求方法（仅支持 GET 或 POST）"},
        {"名称": "请求参数", "类型": "字典", "必填": false, "默认值": null, "说明": "请求参数（请求头/数据；POST 数据自动 JSON 序列化）"},
        {"名称": "超时秒", "类型": "浮点数", "必填": false, "默认值": 10.0, "说明": "连接与读取统一超时（秒）"},
        {"名称": "最大字节数", "类型": "整数", "必填": false, "默认值": 5242880, "说明": "响应大小上限（超出返回 响应超限）"},
        {"名称": "允许回环", "类型": "布尔", "必填": false, "默认值": false, "说明": "是否允许访问回环地址（仅本机测试可开）"},
        {"名称": "取消标记", "类型": "空", "必填": false, "默认值": null, "说明": "取消标记（空表示不取消；已取消返回 请求已取消）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "发送结果 {状态码, 响应头, 响应文本, 错误信息}"}},
      "错误码": ["参数不合法", "请求已取消", "网络超时", "网络失败", "响应超限"],
      "调用示例": {"能力id": "网络请求.发送请求", "参数": {"地址": "https://127.0.0.1:9/示例", "方法": "GET"}}
    },
    {
      "能力id": "网络请求.构建查询串",
      "版本": "1.0.0",
      "说明": "把参数映射编码为 URL 查询串（空映射返回空串），返回 {值=查询串}",
      "参数": [
        {"名称": "参数", "类型": "字典", "必填": true, "默认值": null, "说明": "查询参数映射（键值对）"}
      ],
      "返回": {"类型": "结果", "值结构": {"值": "URL 编码后的查询串（不含前导 ?）"}},
      "错误码": ["参数不合法"],
      "调用示例": {"能力id": "网络请求.构建查询串", "参数": {"参数": {"名称": "示例"}}}
    }
  ]
}
