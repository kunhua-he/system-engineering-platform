{
 "契约版本": "1.0.0",
 "能力契约": [
  {
   "能力id": "网络请求.发送请求",
   "版本": "1.0.0",
   "说明": "发送 HTTP GET/POST 请求（SSRF 防护：默认拒绝回环/内网/私有地址），返回 {值=状态码/响应头/响应文本/错误信息}",
   "参数": [
    {
     "名称": "地址",
     "类型": "文本型",
     "必填": true,
     "默认值": null,
     "说明": "http/https 地址（协议白名单外或回环/内网地址返回 参数不合法）"
    },
    {
     "名称": "方法",
     "类型": "文本型",
     "必填": false,
     "默认值": "GET",
     "说明": "请求方法（仅支持 GET 或 POST）"
    },
    {
     "名称": "请求参数",
     "类型": "字典型",
     "必填": false,
     "默认值": null,
     "说明": "请求参数（请求头/数据；POST 数据自动 JSON 序列化）"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型",
     "必填": false,
     "默认值": 10.0,
     "说明": "连接与读取统一超时（秒）"
    },
    {
     "名称": "最大字节数",
     "类型": "整数型",
     "必填": false,
     "默认值": 5242880,
     "说明": "响应大小上限（超出返回 响应超限）"
    },
    {
     "名称": "允许回环",
     "类型": "逻辑型",
     "必填": false,
     "默认值": false,
     "说明": "是否允许访问回环地址（仅本机测试可开）"
    },
    {
     "名称": "取消标记",
     "类型": "空值型",
     "必填": false,
     "默认值": null,
     "说明": "取消标记（空表示不取消；已取消返回 请求已取消）"
    }
   ],
   "返回": {
    "类型": "结果型",
    "值结构": {
     "值": "发送结果 {状态码, 响应头, 响应文本, 错误信息}"
    }
   },
   "错误码": [
    "参数不合法",
    "请求已取消",
    "网络超时",
    "网络失败",
    "响应超限"
   ],
   "调用示例": {
    "能力id": "网络请求.发送请求",
    "参数": {
     "方法": "GET",
     "超时秒": 10.0,
     "最大字节数": 5242880,
     "允许回环": false
    }
   },
   "行为": {
    "修改输入": false,
    "幂等": true,
    "副作用": "只读",
    "排序稳定": true,
    "时区": "不涉及",
    "编码": "utf-8",
    "精度": "不涉及",
    "空值": "按参数契约处理",
    "输入上限": "由资源预算约束",
    "超时可重试": false,
    "取消": "不支持",
    "重试条件": "无",
    "事务边界": "无",
    "补偿动作": "无",
    "线程安全": true,
    "进程安全": true,
    "资源释放": "按句柄生命周期自动释放",
    "错误码": "统一",
    "可重试性": "参数错误不可重试"
   },
   "提供者": {
