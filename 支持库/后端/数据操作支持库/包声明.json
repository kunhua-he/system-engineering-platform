      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "塑形结果": "塑形后的响应载荷",
          "已塑形": "是否执行了塑形（无任何限制参数时为假）",
          "已截断": "是否发生条目截断或字节截断",
