        {
          "名称": "最大条目数",
          "类型": "整数型",
          "必填": false,
          "默认值": null,
          "说明": "每个列表保留的条目上限"
        },
        {
          "名称": "最大字节数",
          "类型": "整数型",
          "必填": false,
          "默认值": null,
          "说明": "序列化后的字节上限"
