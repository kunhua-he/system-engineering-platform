{
  "包id": "支持库.后端.数据操作支持库.数据交换",
  "名称": "数据交换",
  "类型": "支持库",
  "版本": "1.2.0",
  "说明": "原子数据交换能力：JSON 与 CSV 的序列化/反序列化。只依赖 Python 标准库，无第三方依赖。",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "数据操作支持库.数据交换.序列化JSON",
      "名称": "序列化JSON",
      "参数": [
        {
          "名称": "数据",
          "类型": "字典型",
          "必填": true,
          "默认值": null,
          "说明": "要序列化的数据（字典或列表，须可 JSON 序列化）"
        }
      ],
      "返回": "结果型",
      "说明": "把字典或列表数据序列化为 JSON 文本"
    },
    {
      "能力id": "数据操作支持库.数据交换.反序列化JSON",
      "名称": "反序列化JSON",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "JSON 文本"
        }
      ],
      "返回": "结果型",
      "说明": "把 JSON 文本解析为字典或列表"
    },
    {
      "能力id": "数据操作支持库.数据交换.序列化CSV",
      "名称": "序列化CSV",
      "参数": [
        {
          "名称": "行列表",
          "类型": "列表型",
          "必填": true,
          "默认值": null,
          "说明": "行列表（每行为单元格列表）"
        }
      ],
      "返回": "结果型",
      "说明": "把行列表序列化为 CSV 文本"
    },
    {
      "能力id": "数据操作支持库.数据交换.反序列化CSV",
      "名称": "反序列化CSV",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "CSV 文本"
        },
        {
          "名称": "分隔符",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "单字符分隔符；留空按逗号解析（支持 , \\t ; | ）"
        },
        {
          "名称": "严格模式",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "开启后畸形 CSV（未闭合引号等）返回 反序列化失败"
        }
      ],
      "返回": "结果型",
      "说明": "把 CSV 文本解析为行列表",
      "错误码": [
        "参数不合法",
        "反序列化失败"
      ]
    },
    {
      "能力id": "数据操作支持库.数据交换.解析YAML",
      "名称": "解析YAML",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本型",
          "必填": true
        }
      ],
      "返回": "结果型",
      "说明": "把 YAML 文本解析为数据"
    },
    {
      "能力id": "数据操作支持库.数据交换.序列化YAML",
      "名称": "序列化YAML",
      "参数": [
        {
          "名称": "数据",
          "类型": "JSON值型",
          "必填": true
        }
      ],
      "返回": "结果型",
      "说明": "把数据序列化为 YAML 文本"
    },
    {
      "能力id": "数据操作支持库.数据交换.深合并",
      "名称": "深合并",
      "参数": [
        {
          "名称": "基础",
          "类型": "字典型",
          "必填": true,
          "默认值": null,
          "说明": "基础字典"
        },
        {
          "名称": "覆盖",
          "类型": "字典型",
          "必填": true,
          "默认值": null,
          "说明": "覆盖字典"
        }
      ],
      "返回": "结果型",
      "说明": "递归合并两个字典：同键且两边都是字典时递归合并，否则用覆盖值替换；不修改入参"
    },
    {
      "能力id": "数据操作支持库.数据交换.提取带前缀JSON",
      "名称": "提取带前缀JSON",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "被检索的多行文本"
        },
        {
          "名称": "前缀",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "行前缀，如 @@结果@@"
        },
        {
          "名称": "从末尾查找",
          "类型": "逻辑型",
          "必填": false,
          "默认值": true,
          "说明": "默认 真"
        }
      ],
      "返回": "结果型",
      "说明": "从文本中提取带指定前缀的 JSON 行（默认从末尾找）；剥前缀后必须是 JSON 对象"
    },
    {
      "能力id": "数据操作支持库.数据交换.压缩描述字段",
      "名称": "压缩描述字段",
      "参数": [
        {
          "名称": "数据",
          "类型": "字典型",
          "必填": true,
          "默认值": null,
          "说明": "任意 JSON 结构"
        },
        {
          "名称": "字段名",
          "类型": "文本型",
          "必填": false,
          "默认值": "description",
          "说明": "要折叠的字段名"
        }
      ],
      "返回": "结果型",
      "说明": "递归折叠指定字段的字符串值（折叠空白），只动该字段不改结构与其它键"
    }
  ]
}
