    },
    {
     "名称": "图片字节",
     "类型": "字节集型",
     "必填": false,
     "默认值": null,
     "说明": "图片二进制内容（与图片路径二选一，经临时目录落盘后识别，即时清理）"
    },
    {
     "名称": "语言",
     "类型": "文本型",
     "必填": false,
