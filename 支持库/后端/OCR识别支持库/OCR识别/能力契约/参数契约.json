     "名称": "词级数据",
     "类型": "逻辑型",
     "必填": false,
     "默认值": false,
     "说明": "true 返回词级数据 {词列表}（TSV 解析），false 返回 {文本}"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型",
     "必填": false,
     "默认值": 60,
     "说明": "外部进程超时（超过强杀进程组返回 超时）"
