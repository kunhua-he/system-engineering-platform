{
  "契约版本": "1.0.0",
  "能力契约": [
    {
      "能力id": "数据交换.序列化JSON",
      "版本": "1.0.0",
      "说明": "把字典或列表数据序列化为 JSON 文本（ensure_ascii=False，缩进 2），返回 {值=JSON文本}",
      "参数": [
        {
          "名称": "数据",
          "类型": "字典",
          "必填": true,
          "默认值": null,
          "说明": "要序列化的数据（字典或列表，须可 JSON 序列化；不可序列化返回 序列化失败）"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "值": "JSON 文本字符串（成功时）"
        }
      },
      "错误码": ["参数不合法", "序列化失败"],
      "调用示例": {
        "能力id": "数据交换.序列化JSON",
        "参数": {
          "数据": {"名称": "示例", "数量": 1}
        }
      }
    },
    {
      "能力id": "数据交换.反序列化JSON",
      "版本": "1.0.0",
      "说明": "把 JSON 文本解析为字典或列表，返回 {值=解析后的数据}",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "JSON 文本；非法 JSON 返回 反序列化失败"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "值": "解析后的字典或列表（成功时）"
        }
      },
      "错误码": ["参数不合法", "反序列化失败"],
      "调用示例": {
        "能力id": "数据交换.反序列化JSON",
        "参数": {
          "文本": "{\"名称\": \"示例\"}"
        }
      }
    },
    {
      "能力id": "数据交换.序列化CSV",
      "版本": "1.0.0",
      "说明": "把行列表序列化为 CSV 文本，返回 {值=CSV文本}",
      "参数": [
        {
          "名称": "行列表",
          "类型": "列表",
          "必填": true,
          "默认值": null,
          "说明": "行列表（每行为单元格列表）；非法结构返回 序列化失败"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "值": "CSV 文本字符串（成功时）"
        }
      },
      "错误码": ["参数不合法", "序列化失败"],
      "调用示例": {
        "能力id": "数据交换.序列化CSV",
        "参数": {
          "行列表": [["名称", "数量"], ["示例", 1]]
        }
      }
    },
    {
      "能力id": "数据交换.反序列化CSV",
      "版本": "1.0.0",
      "说明": "把 CSV 文本解析为行列表，返回 {值=行列表}",
      "参数": [
        {
          "名称": "文本",
          "类型": "文本",
          "必填": true,
          "默认值": null,
          "说明": "CSV 文本；非法 CSV 返回 反序列化失败"
        }
      ],
      "返回": {
        "类型": "结果",
        "值结构": {
          "值": "行列表（成功时，每行为字符串单元格列表）"
        }
      },
      "错误码": ["参数不合法", "反序列化失败"],
      "调用示例": {
        "能力id": "数据交换.反序列化CSV",
        "参数": {
          "文本": "名称,数量\n示例,1"
        }
      }
    }
  ]
}
