{
  "契约版本": "验证场景/v1",
  "验证场景": [
    {
      "场景id": "XML解析.三能力正向HTTP",
      "前置步骤": [
        {
          "步骤id": "前置读取XML夹具",
          "能力id": "文件系统支持库.文件操作.读取文件",
          "参数": {
            "文件路径": {
              "$动态": "夹具文件复制",
              "来源": "夹具/最小目录.xml",
              "目标": "XML/最小目录.xml"
            },
            "编码": "utf-8"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值类型": "文本型",
              "包含": "<目录>"
            }
          }
        }
      ],
      "目标步骤": [
        {
          "步骤id": "目标解析XML",
          "能力id": "XML解析支持库.解析XML",
          "参数": {
            "XML文本": {
              "$动态": "步骤返回",
              "步骤id": "前置读取XML夹具",
              "JSON路径": "$.值"
            }
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "关键值": {
                "根节点.名称": "目录",
                "节点数": 3
              },
              "必需字段": [
                "根节点",
                "节点数"
              ],
              "字段类型": {
                "根节点": "字典型",
                "节点数": "整数型"
              }
            }
          }
        },
        {
          "步骤id": "目标生成XML",
          "能力id": "XML解析支持库.生成XML",
          "参数": {
            "根节点名": "目录",
            "子节点": [
              {
                "名称": "条目",
                "文本": "甲",
                "属性": {
                  "id": "1"
                }
              },
              {
                "名称": "条目",
                "文本": "乙",
                "属性": {
                  "id": "2"
                }
              }
            ]
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "包含": "<目录>",
              "必需字段": [
                "XML文本"
              ],
              "字段类型": {
                "XML文本": "文本型"
              }
            }
          }
        },
        {
          "步骤id": "目标查询节点",
          "能力id": "XML解析支持库.查询节点",
          "参数": {
            "XML文本": {
              "$动态": "步骤返回",
              "步骤id": "目标生成XML",
              "JSON路径": "$.值.XML文本"
            },
            "XPath": "./条目"
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "关键值": {
                "找到": true,
                "数量": 2
              },
              "必需字段": [
                "结果列表"
              ],
              "字段类型": {
                "结果列表": "列表型"
              }
            }
          }
        }
      ],
      "清理步骤": [
        {
          "步骤id": "finally删除XML夹具",
          "能力id": "文件系统支持库.文件操作.删除文件",
          "参数": {
            "文件路径": {
              "$动态": "夹具文件复制",
              "来源": "夹具/最小目录.xml",
              "目标": "XML/最小目录.xml"
            }
          },
          "预期": {
            "成功": true,
            "状态码": 200,
            "返回断言": {
              "值": true
            }
          }
        }
      ]
    }
  ]
}
