     "类型": "数字",
     "必填": false,
     "默认值": 30,
     "说明": "子进程执行超时"
    }
   ],
   "返回": "结果",
   "错误码": [
    "文件损坏",
    "提供者不可用",
    "超时",
    "提供者崩溃"
   ]
  },
  {
   "能力id": "PDF隔离提供者.检查提供者",
   "参数": [
    {
     "名称": "超时秒",
     "类型": "数字",
     "必填": false,
     "默认值": 30,
     "说明": "子进程执行超时"
    }
   ],
   "返回": "结果",
   "错误码": [
    "提供者不可用",
    "超时",
