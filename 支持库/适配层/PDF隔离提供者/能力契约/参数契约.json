     "必填": true,
     "说明": "待解析文件绝对路径"
    },
    {
     "名称": "最大页数",
     "类型": "整数",
     "必填": false,
     "默认值": 500,
     "说明": "页数上限，0=不限制"
    },
    {
     "名称": "最大字节数",
     "类型": "整数",
     "必填": false,
     "默认值": 0,
     "说明": "文件大小上限，0=不限制"
    },
    {
     "名称": "超时秒",
     "类型": "数字",
     "必填": false,
     "默认值": 90,
     "说明": "子进程执行超时"
    }
   ],
   "返回": "结果",
   "错误码": [
    "提供者不可用",
    "文件不存在",
    "文件加密",
    "文件损坏",
    "超出限制",
    "超时",
    "提供者崩溃"
   ]
  },
  {
   "能力id": "PDF隔离提供者.校验PDF",
