   "能力id": "PDF隔离提供者.解析PDF",
   "名称": "解析PDF",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "最大页数",
     "类型": "整数型"
    },
    {
     "名称": "最大字节数",
     "类型": "整数型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "隔离解析 PDF 为通用文档字典（块列表/资源列表/标题/警告）：pdfplumber 提取文本表格图像，fitz 补充加密判定与图像渲染"
  },
  {
   "能力id": "PDF隔离提供者.校验PDF",
   "名称": "校验PDF",
   "参数": [
    {
     "名称": "字节",
     "类型": "字节集型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "隔离重新打开 PDF 返回页数（生成签名校验用）：fitz 优先，pdfplumber 回退"
  },
  {
   "能力id": "PDF隔离提供者.检查提供者",
   "名称": "检查提供者",
   "参数": [
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "隔离探测 pdfplumber/fitz 版本与可用性：返回 {提供者版本{pdfplumber, fitz}}"
  }
 ],
 "配置项": [
  {
