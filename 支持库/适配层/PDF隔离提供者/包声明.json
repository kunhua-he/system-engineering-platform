{
 "包id": "支持库.适配层.PDF隔离提供者",
 "名称": "PDF隔离提供者",
 "类型": "支持库",
 "版本": "1.0.0",
 "说明": "PDF 原生第三方提供者（pdfplumber/PyMuPDF）隔离到独立子进程执行：主进程零加载第三方库，子进程覆盖启动/调用/超时/崩溃/重启/停止与残留清理，崩溃只返回提供者崩溃。",
 "入口": "__init__.py",
 "依赖": [],
 "能力": [
  {
   "能力id": "PDF隔离提供者.解析PDF",
   "名称": "解析PDF隔离",
   "参数": [
    {
     "名称": "文件路径",
     "类型": "文本型"
    },
    {
     "名称": "最大页数",
     "类型": "整数型"
    },
    {
     "名称": "最大字节数",
     "类型": "整数型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "在隔离子进程中解析 PDF，返回通用文档字典"
  },
  {
   "能力id": "PDF隔离提供者.校验PDF",
   "名称": "校验PDF隔离",
   "参数": [
    {
     "名称": "字节",
     "类型": "字节集型"
    },
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "在隔离子进程中重开 PDF 返回页数（签名校验）"
  },
  {
   "能力id": "PDF隔离提供者.检查提供者",
   "名称": "检查提供者版本",
   "参数": [
    {
     "名称": "超时秒",
     "类型": "双精度数型"
    }
   ],
   "返回": "结果型",
   "说明": "在隔离子进程中探测 pdfplumber/fitz 版本"
  }
 ],
 "配置项": [
  {
   "配置名称": "默认超时秒",
   "类型": "双精度数型",
   "必填": false,
   "默认值": 90,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "隔离子进程默认执行超时",
   "错误码": "超时"
  },
  {
   "配置名称": "禁用库",
   "类型": "文本型",
   "必填": false,
   "默认值": "",
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "环境变量 PDF隔离提供者_禁用库（逗号分隔，fitz/pdfplumber）用于模拟提供者不可用",
   "错误码": "提供者不可用"
  }
 ]
}
