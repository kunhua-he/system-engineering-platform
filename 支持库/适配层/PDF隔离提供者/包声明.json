   "类型": "双精度数型",
   "必填": false,
   "默认值": 90,
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "隔离子进程默认执行超时",
   "错误码": "超时"
  },
  {
   "配置名称": "禁用库",
   "类型": "文本型",
   "必填": false,
   "默认值": "",
   "允许项目覆盖": true,
   "允许运行时覆盖": true,
   "敏感": false,
   "说明": "环境变量 PDF隔离提供者_禁用库（逗号分隔，fitz/pdfplumber）用于模拟提供者不可用",
   "错误码": "提供者不可用"
  }
 ]
}