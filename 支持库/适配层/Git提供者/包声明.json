{
 "包id": "支持库.适配层.Git提供者",
 "名称": "Git提供者",
 "类型": "支持库",
 "版本": "1.0.0",
 "说明": "Git 外部命令独立提供者：worktree 创建/查询/关闭、提交、回滚、挑拣合入、当前状态。分支名/路径/提交哈希结构化参数白名单（拒绝空格/换行/;|&`$ 等元字符），全部命令以 subprocess 参数列表受管执行（禁 shell 拼接）。",
 "入口": "__init__.py",
 "依赖": [],
 "能力": [
  {
   "能力id": "Git操作.检查提供者",
   "名称": "检查提供者",
   "参数": [],
   "返回": "结果",
   "说明": "git --version 真实探针：返回 {git: 可用, 版本}；缺失/超时 → 提供者不可用"
  },
  {
   "能力id": "Git操作.创建工作区",
   "名称": "创建工作区",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "新路径", "类型": "文本"},
    {"名称": "分支名", "类型": "文本"},
    {"名称": "起始点", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git worktree add [-b 分支名] 路径 [起始点]：新建独立工作区，返回 {路径, 分支}"
  },
  {
   "能力id": "Git操作.查询工作区",
   "名称": "查询工作区",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git worktree list --porcelain：返回 {工作区列表: [{路径, 分支, 提交}]}"
  },
  {
   "能力id": "Git操作.关闭工作区",
   "名称": "关闭工作区",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "目标路径", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git worktree remove 非强制关闭：先查未提交修改，存在 → 未提交修改 拒绝"
  },
  {
   "能力id": "Git操作.提交",
   "名称": "提交",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "路径列表", "类型": "列表"},
    {"名称": "消息", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git add 指定路径 + git commit 最小原子提交；路径越界 → 路径越界"
  },
  {
   "能力id": "Git操作.回滚",
   "名称": "回滚",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "提交哈希", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git revert --no-edit 撤销指定提交；冲突自动 --abort 恢复干净状态"
  },
  {
   "能力id": "Git操作.挑拣合入",
   "名称": "挑拣合入",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "提交哈希", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "git cherry-pick 挑拣指定提交到当前分支；冲突自动 --abort 恢复干净状态"
  },
  {
   "能力id": "Git操作.当前状态",
   "名称": "当前状态",
   "参数": [
    {"名称": "仓库路径", "类型": "文本"},
    {"名称": "超时秒", "类型": "数字"}
   ],
   "返回": "结果",
   "说明": "status/log 摘要：{分支, 未提交修改, 最近提交}"
  }
 ]
}
