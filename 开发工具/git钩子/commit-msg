#!/bin/sh
# 系统工程平台 · 提交强制点（commit-msg 钩子）
#
# ── 为什么有它（哲学 13.1：判据在 ≠ 判据接线）────────────────────────────────
# 本仓有两条执行腿：MCP 能力腿 与 终端 git 腿。**唯一的公共汇聚点就是 `git commit`**
# —— 终端腿拦不住（任何进程都能敲 git），MCP 腿的审计只覆盖走 MCP 的那部分。
# 而 `.git/hooks/` 此前为空、`core.hooksPath` 未设 ⇒「必须走平台」只靠人记得。
# 本钩子把它变成**必经路径上的检查**：不声明开工ID 就提交不了。
#
# ── 判据（两问，唯一、可机检）────────────────────────────────────────────────
# 问一（声明级）：提交消息里必须带**开工ID**（形如 `开工-20260923-131126-78e8`）。
# 问二（实证级，2026-09-25；修假红后＝**两小问，先活跃、再全量**）：该开工ID 必须**平台发过**
#   —— 拿它去租约账核验它当没当过 `所有者`：
#     · 活跃写租约账里有 ⇒ 放行（现状）；
#     · 活跃账里没有、**全量账**（含 `已释放` / `已过期`）里有 ⇒ 放行，并打印一行如实提示。
#       为什么必须放行这一档（2026-09-25 现场取证，本钩子旧版正是栽在这）：释放租约是
#       **把记录改状态、不删记录**（`实现/文件租约维护.py` 的 `记录["状态"] = "已释放"`），
#       而正常流程是**先收工释放、后提交**（AGENTS.md：收工按 开工ID 提交 ＋ 收工调 收工释放）
#       ⇒ 只查「活跃」会把一条**平台刚发过的真开工ID** 判成「查无」而拒 —— 那是判据取错了
#       事实源（取「谁还占着」当「谁发过」），不是可达上限；已释放/过期**照样证明平台发过它**。
#     · 两张表都没有 ⇒ 拒（编造 ID）。
#   数据源**唯一** = `平台控制面/能力目录/文件租约存储.写租约所有者表`（`只要活跃` 参数表达
#   两小问：缺省真=活跃档，假=全量档）；活跃档复用 `公共契约/运行时/写入授权.py` 已注册的
#   写租约事实源，全量档直接 import 同一个函数 —— **两种档都是同一个函数**，
#   不在钩子里另写一套租约读取、不自己解析账本 JSON。
#   口径与 MCP 提交腿（`提交回滚.py::_核验开工ID存在`）逐字一致。
# 为什么是开工ID：它是平台唯一的授权凭证 —— 只有走过 `开工即占`（互斥门）才拿得到，
# 没它就没有租约、没有改动流水、没有收工释放。
#
# ── 可达上限（如实说明，不装作更强）────────────────────────────────────────
# ① 本钩子的问二跑在**终端、没有 MCP**：它 `cd 仓库根` 后起一个 `python -c` 读**本机**租约账
#    （离线可跑）。故它只对本机能 import 到 `平台控制面` 的情形有效；import 不到 ⇒ 按下面
#    「设计约束① 钩子自身出错一律放行」处置 ⇒ 那种环境下本钩子退化成「声明级」，
#    实证由 MCP 提交腿（fail-closed）保证。
# ② **租约过期/已释放不再拒**（2026-09-25 修假红）：问二改问「平台发过没发过」——
#    全量账（含 `已释放` / `已过期`）里有即放行，只打印一行提示；故一条真ID 不会因其租约
#    过期/被回收而被拒（旧版的「查无即拒」是判据取错事实源，不是可达上限）。
# ③ `所有者` **恒为本次开工ID**：`开工即占` 不认调用方传的 `所有者`，传了**不生效、不落账**
#    （2026-09-25 同批实测翻转）。故「开工时覆盖 所有者」这条旧说明**已过期**，不再构成
#    拒因；本条只留作口径记录，排查时别按旧口径找。
# ④ `git commit --no-verify` 是 git 内建绕过口，本钩子拦不住（MCP 提交腿没有它）。
#
# ── 两条设计约束 ───────────────────────────────────────────────────────────
# ① **本钩子自身出错一律放行**（exit 0 + 大声告警）：钩子坏了不该让整个仓库提交瘫痪。
#    只有「检查跑完了、且确实没声明」这一种情况才拒。
# ② 绕过通道 = `git commit --no-verify`（git 内建）。**MCP 提交腿没有这个通道**
#    （`支持库/适配层/Git提供者/实现/提交回滚.py:57` 的签名里没有它）⇒ 对 MCP 腿是严格强制。
#
# ★ 标识符一律 ASCII：`sh` 不接受非 ASCII 函数名（实测 `告警() {` 报
#   `not a valid identifier` 并让整份钩子 exit 2 —— 那会把所有提交都挡死）。
#   中文只留在输出消息里。

set -u

warn() { printf '%s\n' "$*" >&2; }

# ── 问二（实证级，2026-09-25）：核验开工ID 是不是平台发过的 ──────────────────
# 两小问，先活跃、再全量（同一个函数 `写租约所有者表` 的 `只要活跃` 参数表达）：
#   活跃档（`只要活跃=真`，缺省）复用 `公共契约/运行时/写入授权.py` 已注册的写租约事实源；
#   全量档（`只要活跃=假`）直接 import `平台控制面/能力目录/文件租约存储.写租约所有者表`。
# **两种档都是同一个函数**（不在钩子里另写一套租约读取、不自己解析账本 JSON）。
# 口径与 MCP 提交腿（`提交回滚.py::_核验开工ID存在`）逐字一致。
# 退出：活跃有 ⇒ print `开工ID核验=存在` + exit 0；
#       仅全量有 ⇒ print `开工ID核验=已释放` + exit 0（打印一行如实提示）；
#       两表都没有 ⇒ print `开工ID核验=不存在` + exit 1；
#       核验不可用（钩子自身出错）⇒ 大声告警并 exit 0（设计约束①）。
# ★ 标识符一律 ASCII；`$变量` 后紧跟非 ASCII 时一律写 `${VAR}`（见文件头实测量注）。
verify_workid() {
    vf="${1:-}"
    kid="$(grep -oE '开工-[0-9]{8}-[0-9]{6}-[0-9a-f]{4,}' "$vf" 2>/dev/null | head -n 1)"
    if [ -z "$kid" ]; then
        warn "⚠ 提交强制点：从消息里取不出开工ID，无法核验真伪 —— 本钩子放行（钩子自身的问题）。"
        exit 0
    fi
    root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$root" ]; then
        warn "⚠ 提交强制点：拿不到仓库根，无法核验开工ID 真伪 —— 本钩子放行（钩子自身的问题）。"
        exit 0
    fi
    py=""
    for cand in /opt/homebrew/bin/python3.14 python3.14 python3; do
        if command -v "$cand" >/dev/null 2>&1; then py="$cand"; break; fi
    done
    if [ -z "$py" ]; then
        warn "⚠ 提交强制点：找不到 python 解释器，无法核验开工ID 真伪 —— 本钩子放行（钩子自身的问题）。"
        exit 0
    fi
    out="$(cd "$root" && "$py" -c '
import sys
wid = sys.argv[1]
try:
    import 平台控制面.能力目录  # noqa: F401 —— 载入即触发 文件租约存储 自注册
    from 公共契约.运行时 import 写入授权 as 授权
    from 平台控制面.能力目录.文件租约存储 import 写租约所有者表
except BaseException as e:
    print("开工ID核验=不可用")
    print("载入写租约事实源失败：%s: %s" % (type(e).__name__, e))
    sys.exit(3)
reader, q = 授权._取读取器()
if reader is None:
    print("开工ID核验=不可用")
    print("写租约事实源未注册：%s" % (q or "（未注册）",))
    sys.exit(3)
try:
    活跃表, q2 = reader()
except BaseException as e:
    print("开工ID核验=不可用")
    print("租约事实源抛错：%s: %s" % (type(e).__name__, e))
    sys.exit(3)
if 活跃表 is None:
    print("开工ID核验=不可用")
    print("租约事实源不可用：%s" % (q2 or "（无说明）",))
    sys.exit(3)
活跃所有者集 = {v for v in 活跃表.values() if v}
if wid in 活跃所有者集:
    print("开工ID核验=存在")
    print("活跃写租约 %d 条，所有者 %d 个" % (len(活跃表), len(活跃所有者集)))
    sys.exit(0)
try:
    全量表, q3 = 写租约所有者表(只要活跃=False)
except BaseException as e:
    print("开工ID核验=不可用")
    print("全量租约事实源抛错：%s: %s" % (type(e).__name__, e))
    sys.exit(3)
if 全量表 is None:
    print("开工ID核验=不可用")
    print("全量租约事实源不可用：%s" % (q3 or "（无说明）",))
    sys.exit(3)
全量所有者集 = {v for v in 全量表.values() if v}
if wid in 全量所有者集:
    print("开工ID核验=已释放")
    print("该开工ID 在账里存在，但其租约已释放/过期 —— 按「平台发过的真 ID」放行；"
          "若你还要继续改文件，请重新 开工即占")
    sys.exit(0)
print("开工ID核验=不存在")
print("活跃写租约 %d 条，全量记录 %d 条" % (len(活跃表), len(全量表)))
sys.exit(1)
' "$kid" 2>&1)"
    mark="$(printf '%s\n' "$out" | sed -n '1p')"
    if [ "$mark" = "开工ID核验=存在" ]; then
        return 0
    fi
    if [ "$mark" = "开工ID核验=已释放" ]; then
        warn ""
        warn "⚠ 提交强制点：开工ID ${kid} 在账里存在，但其租约已释放/过期 —— 按「平台发过的真 ID」放行。"
        warn "  若你还要继续改文件，请重新 \`开工编排.开工即占\`（互斥门）拿一份新租约。"
        warn ""
        return 0
    fi
    if [ "$mark" = "开工ID核验=不存在" ]; then
        warn ""
        warn "✗ 提交被拒：开工ID ${kid} 在写租约账里查无 —— 它不是一个真实存在的开工ID。"
        warn ""
        warn "  为什么拒：任何人都能编一个形如 \`开工-20260925-120000-dead\` 的字符串写进消息，"
        warn "  只查「消息里声明了ID」拦不住编的；本问拿 ID 去租约账核对，只认真的。"
        warn "  已释放/已过期的记录照样算「发过」而放行；两张表都没有才拒。"
        warn ""
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        warn ""
        warn "  怎么改：调 \`开工编排.开工即占\`（传 项目根 / 任务 / 修改路径）拿**真**开工ID"
        warn "  —— 它同时原子认领修改路径（互斥门）；把真ID 写进提交消息再提交。"
        warn "  （若你确实在**修 MCP 自身**：用 \`git commit --no-verify\` 绕过，并在消息里写明为什么。）"
        exit 1
    fi
    warn "⚠ 提交强制点：开工ID 真伪核验**不可用**（拿不到写租约事实源）—— 本钩子放行。"
    warn "  这是钩子自身的问题，不是你的提交有问题（既有设计约束：钩子自身出错一律放行）。"
    warn "  本腿只做到「声明级」；实证由 MCP 提交腿（fail-closed）保证。"
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    exit 0
}

msgfile="${1:-}"

if [ -z "$msgfile" ] || [ ! -f "$msgfile" ]; then
    warn "⚠ 提交强制点：拿不到提交消息文件（收到 '$msgfile'）—— 本钩子放行。"
    warn "  这是钩子自身的问题，不是你的提交有问题；请检查 core.hooksPath 与 git 版本。"
    exit 0
fi

# git 自身的流程消息（合并/回退/自动 fixup）不要求开工ID —— 它们不是「一次开发改动」。
if grep -Eq '^(Merge |Revert |fixup! |squash! )' "$msgfile" 2>/dev/null; then
    exit 0
fi

if grep -Eq '开工-[0-9]{8}-[0-9]{6}-[0-9a-f]{4,}' "$msgfile" 2>/dev/null; then
    # 问二（实证级）：核验这个开工ID 真的存在（不存在则本函数 exit 1；核验不可用则放行）。
    verify_workid "$msgfile"
    exit 0
fi

warn ""
warn "✗ 提交被拒：提交消息里没有开工ID。"
warn ""
warn "  本仓规定（AGENTS.md）：一切改动从 \`开工编排.开工即占\` 进 —— 它发开工ID，"
warn "  同时原子认领 \`修改路径\`（互斥门）。没有开工ID 的改动不合规。"
warn ""
warn "  怎么改："
warn "    1) 调 开工编排.开工即占（传 项目根 / 任务 / 修改路径）拿 开工ID；"
warn "    2) 把开工ID 写进提交消息开头，形如："
warn "       开工-20260923-131126-78e8 <你改了什么、怎么验的>"
warn "    3) 收工调 开工编排.收工释放 释放租约。"
warn ""
warn "  （确实不该有开工ID 的极少数场合：git commit --no-verify 绕过，并在回传里写明为什么。）"
warn ""
exit 1
