#!/bin/sh
# 系统工程平台 · 提交强制点（commit-msg 钩子）
#
# ── 为什么有它（哲学 13.1：判据在 ≠ 判据接线）────────────────────────────────
# 本仓有两条执行腿：MCP 能力腿 与 终端 git 腿。**唯一的公共汇聚点就是 `git commit`**
# —— 终端腿拦不住（任何进程都能敲 git），MCP 腿的审计只覆盖走 MCP 的那部分。
# 而 `.git/hooks/` 此前为空、`core.hooksPath` 未设 ⇒「必须走平台」只靠人记得。
# 本钩子把它变成**必经路径上的检查**：不声明开工ID 就提交不了。
#
# ── 判据（唯一、可机检）──────────────────────────────────────────────────────
# 提交消息里必须带**开工ID**（形如 `开工-20260923-131126-78e8`）。
# 为什么是开工ID：它是平台唯一的授权凭证 —— 只有走过 `开工即占`（互斥门）才拿得到，
# 没它就没有租约、没有改动流水、没有收工释放。
#
# ── 可达上限（如实说明，不装作更强）────────────────────────────────────────
# 本钩子只能证明「**消息里声明了**开工ID」，**证明不了这个 ID 是真的**。
# 强校验 = 拿 ID 去核对改动流水（`查询改动历史`）；那一步在提交腿里做，不在钩子里
# （钩子要快、要能在没有网关时也跑）。见债务清单「强制点只做到声明级」。
#
# ── 两条设计约束 ───────────────────────────────────────────────────────────
# ① **本钩子自身出错一律放行**（exit 0 + 大声告警）：钩子坏了不该让整个仓库提交瘫痪。
#    只有「检查跑完了、且确实没声明」这一种情况才拒。
# ② 绕过通道 = `git commit --no-verify`（git 内建）。**MCP 提交腿没有这个通道**
#    （`支持库/适配层/Git提供者/实现/提交回滚.py:57` 的签名里没有它）⇒ 对 MCP 腿是严格强制。
#
# ★ 标识符一律 ASCII：`sh` 不接受非 ASCII 函数名（实测 `告警() {` 报
#   `not a valid identifier` 并让整份钩子 exit 2 —— 那会把所有提交都挡死）。
#   中文只留在输出消息里。

set -u

warn() { printf '%s\n' "$*" >&2; }

msgfile="${1:-}"

if [ -z "$msgfile" ] || [ ! -f "$msgfile" ]; then
    warn "⚠ 提交强制点：拿不到提交消息文件（收到 '$msgfile'）—— 本钩子放行。"
    warn "  这是钩子自身的问题，不是你的提交有问题；请检查 core.hooksPath 与 git 版本。"
    exit 0
fi

# git 自身的流程消息（合并/回退/自动 fixup）不要求开工ID —— 它们不是「一次开发改动」。
if grep -Eq '^(Merge |Revert |fixup! |squash! )' "$msgfile" 2>/dev/null; then
    exit 0
fi

if grep -Eq '开工-[0-9]{8}-[0-9]{6}-[0-9a-f]{4,}' "$msgfile" 2>/dev/null; then
    exit 0
fi

warn ""
warn "✗ 提交被拒：提交消息里没有开工ID。"
warn ""
warn "  本仓规定（AGENTS.md）：一切改动从 \`开工编排.开工即占\` 进 —— 它发开工ID，"
warn "  同时原子认领 \`修改路径\`（互斥门）。没有开工ID 的改动不合规。"
warn ""
warn "  怎么改："
warn "    1) 调 开工编排.开工即占（传 项目根 / 任务 / 修改路径）拿 开工ID；"
warn "    2) 把开工ID 写进提交消息开头，形如："
warn "       开工-20260923-131126-78e8 <你改了什么、怎么验的>"
warn "    3) 收工调 开工编排.收工释放 释放租约。"
warn ""
warn "  （确实不该有开工ID 的极少数场合：git commit --no-verify 绕过，并在回传里写明为什么。）"
warn ""
exit 1
