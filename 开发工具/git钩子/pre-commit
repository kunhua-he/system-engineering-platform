#!/bin/sh
# 系统工程平台 · 落盘强制点（pre-commit 钩子）
#
# ── 为什么有它（华哥 2026-09-23 裁决）────────────────────────────────────────
# 「改代码，也加上全局限制，也要用 mcp，否则我 mcp 开发出来干啥？最好是做硬盘 IO 限制，
#   本项目的所有变动，都需要 mcp。mcp 除外，等于说修 mcp 可以用终端，但是除了 mcp 以外的，
#   都必须要用 mcp 的工具。否则全部拒绝落盘。」
#
# 与 `commit-msg` 的分工（**互补，不重叠**）：
#   · `commit-msg`    管「**谁授权**」——消息里必须有开工ID（走过 开工即占 才拿得到）；
#   · 本钩子·判据一   管「**锁在不在位**」——整仓内核锁有缺口即拒（2026-09-23 补）；
#   · 本钩子·判据二   管「**怎么落的盘**」——本轮改动的内容是不是经平台工具写的。
# 三问都过才放行：授权（谁批的）、前提（锁在不在）、路径（怎么落的）。
#
# ── 判据一：整仓内核锁必须在位（本钩子唯一的「硬件权限」环节）────────────────────
# 华哥裁决「不靠 agent 自觉，**纯粹电脑硬件权限管控**」落地成 `chflags uchg` 整仓只读锁
# （唯一实现在 `公共契约/运行时/仓库只读锁.py`）之后，锁虽然「开着」，却**没有任何东西
# 阻止**有人 `--下锁` 之后一直开着 —— 那是那条裁决里**唯一还靠自觉**的一环。本判据把它钉在
# 提交这个公共汇聚点上：锁不在位 ⇒ 拒提交。
#
# 判据本体（**唯一腿**）：`公共契约/运行时/仓库只读锁.查询(<仓库根>)` 的 **`缺口数`**。
# 本钩子只读这个数，**不自己再过滤一遍豁免前缀**、也**不自己去读租约账** —— `.git/`、
# `工程缓存/`、`.venv/`、`node_modules/` 已由 `查询()` 的受管面排除；而「未锁里哪些是活跃
# 租约开窗」由 `查询()` 按**唯一判据**（`仓库只读锁.活跃租约开窗集` ＋ `未锁分档`）分好档
# （在钩子里再筛一次＝同一判据的第二条腿，哲学 1.2）。
#
# ★ 为什么不能拿 `未锁数` 判红（2026-09-24 实测误拒）：认领一条路径（`开工编排.开工即占`）
#   成功即 `解锁供写入(目标 ＋ 父链)` ⇒ 认领期间那几条**本来就该是未锁**，那是**设计行为**。
#   `未锁数 > 0` 会把「活跃租约开窗」当成「缺口」拒掉提交（现场：整仓 `未锁 2`，而那 2 条
#   正是另一会话活跃租约的开窗 —— zcode 会话亲历）。分档为何只做在入口侧，见
#   `公共契约/运行时/仓库只读锁.py` 的「未锁分档」注释块。
#
# ★ 边界口径（三种「不是锁在位」必须分开处置；理由写在这里，不靠猜）：
#   ① 锁确实有缺口（`查询` 跑通、**`缺口数` > 0**）⇒ **拒**。这是本判据的本职。
#      （只有活跃租约开窗、缺口数 0 ⇒ **在位放行**，但如实打印开窗条数，不静默。）
#   ② 平台不支持内核锁（`支持内核锁()` 为假，即非 macOS）⇒ **放行 + 大声告警**（fail-open）。
#      理由：这不是「判据坏了」，而是「**本平台根本没有这套机制**」—— `chflags` 是 macOS
#      专有，Linux 没有属主可设的等价标志。此时没有任何东西能「在位」，强判等于给非 macOS
#      造一个**永远修不好的假红**（照提示做了也变不了绿），而整条裁决本来就是 macOS 口径。
#      ⇒ 判据「**无问题可问**」（机制不存在）与「**问不到**」（判据坏了）是两回事，只有后者
#        fail-closed。
#   ③ 判据自身不可用（导入 `仓库只读锁` 失败 / `查询` 抛错 / 进程在启动处就被别的东西拦下）
#      ⇒ **拒**（fail-closed）。理由：本仓既有口径就是「判据自身不可用 ⇒ 未核验 fail-closed」
#      （`sitecustomize.py` 判据第 3 层同款）。**与「钩子自身出错一律放行」不冲突**：那条说的是
#      **脚手架**（拿不到仓库根 / 找不到解释器 / 读不到消息文件）坏了不该瘫痪全仓提交；而锁核验
#      是**一条安全判据**，「问不到」意味着门开着且没人看守，放行＝把裁决作废。
#      一句话记：**脚手架坏了放行，判据坏了拒绝**（凭据腿同款：它 import 不到判据也是拒）。
#      副产物（如实标注）：若有人把 `core.hooksPath` 设成全局、在**别的仓库**里跑本钩子，
#      导入会失败 ⇒ 那个仓库的提交被拒。这是刻意的（宁可拒也不静默放行）；本钩子按约定是
#      **仓库本地**接线（`git config core.hooksPath 开发工具/git钩子`），正常落不到别的仓库。
#
# ★ 为什么不能只看 `python -c` 的退出码：那个进程可能**在我们的代码之前**就被拦掉 ——
#   实测 2026-09-23：带本仓 `PYTHONPATH` 时仓库根 `sitecustomize.py` 会以 `os._exit(1)`
#   拒绝启动，连我们那句 print 都跑不到，退出码 1 与「有缺口」的退出码撞车。
#   故核验脚本**第一行必须是机器标记**（`锁核验=在位|缺口|不适用|不可用`），shell 只认这一行；
#   标记缺失 ⇒ 按「不可用」处置 ⇒ 拒。这样「判据没跑起来」与「判据跑起来且报了缺口」不会混淆。
#
# ── 判据二（唯一腿，不在钩子里重写）──────────────────────────────────────────
# 判据本体是 `开发工具/MD文档生成 --拒绝手写校验`（它已把「问一 机器印记 + 问二 写入凭据」
# 两问合成，见该件 docstring）。本钩子**只调它、读它的退出码**，不自己读流水、不自己算指纹 ——
# 在钩子里另写一套就是同一判据的第二条腿（哲学 1.2）。
#
# 为什么钩子调的是 MD 文档生成而不是别的：写类能力的凭据**都写进同一条流水**
# （`公共契约/诊断/写入流水.py`，三条写入腿都接它），而消费这条流水、且已接在必经路径上的
# 判据就是它。判据长在能力面上，钩子只是「把它挂到提交这个公共汇聚点」。
#
# ── 可达上限（如实说明，不装作更强）────────────────────────────────────────
# ① 可绕过：`git commit --no-verify` 是 git 内建通道，任何钩子都拦不住（无法封闭）。
#    不是钩子没写好，是这一层机制的边界 —— 故本钩子不假装能拦住“所有”绕过。
# ② 只管**已暂存**的改动（`git diff --cached`），工作区里尚未暂存的临时改动它看不见
#    （那种改动还没到“落盘为版本”这一步）。
# ③ 凭据是**本次会话开始记录**的：存量文件（此前经终端写的）第一次进改动集时
#    会没有凭据 ⇒ 那时**只告警不拒绝**（存量冻结口径，与本仓既有门禁一致），
#    只有「本次会话新建/重写的文件」才按缺凭据拒。这条边界必须写明，否则第一次提交
#    会被存量全部挡死（那正是本仓反复栽过的「判据太宽＝假红」）。
#
# ── 设计约束（与 commit-msg 同）────────────────────────────────────────────
# **脚手架**出错一律放行（exit 0 + 大声告警）：拿不到仓库根 / 找不到解释器 / 读不到消息文件，
# 都是「本钩子自己坏了」，不该让整个仓库提交瘫痪。
# 拒只有两种情况：「检查真跑完了、且确实缺凭据」，以及判据一的 ①（锁有缺口）与 ③（判据自身
# 不可用）。**脚手架坏了放行、判据坏了拒绝** —— 判据一边界口径③ 的完整理由见文件头部。
#
# ★ 标识符一律 ASCII（**实测事故，2026-09-23**）：本钩子的 shebang 是 `#!/bin/sh`，
#   而 macOS 的 `/bin/sh` 是 **bash 3.2**（实测 `3.2.57(1)-release`），它**不接受
#   非 ASCII 变量名** —— 初版把变量写成 `根=` / `解释器=`，被 bash 3.2 当成「命令名」
#   执行：`line 40: 根=/Users/…: No such file or directory`，紧接着 `set -u` 下
#   `$根` 未绑定 ⇒ 脚本在**第 41 行就退出 1**，`exit 0` 的「放行」分支永远走不到。
#   后果不是「钩子不生效」而是**每一笔提交都被拒**（两条腿都拦死）。
#   实测取证：`git hook run pre-commit` → 退出码 1 + 上述两行报错；
#   复跑：`/bin/sh 开发工具/git钩子/pre-commit; echo $?` → 1。
#   ⇒ 中文只留在输出消息里（`warn "…"`），**变量名/函数名一律 ASCII**。
#   ★ 同族的第二个坑（本轮加锁核验时**实测踩到**，2026-09-23）：**变量后面紧跟非 ASCII
#     字符时，必须写 `${VAR}`** —— bash 3.2 会把那个多字节字符的首字节吞进变量名：
#     初版写 `warn "…退出码 $LOCKRC。若…"`，`set -u` 下报
#     `line 175: LOCKRC\xef: unbound variable`，脚本在那一行崩、**本该打出来的修法提示
#     只剩半截**（退出码恰为 1，于是「拒了」看着像对的，其实是崩了 —— 假绿）。
#     修法：写成 `${LOCKRC}`。凡「`$变量` + 中文标点」的地方都要这么写。

set -u
warn() { printf '%s\n' "$*" >&2; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
    warn "⚠ 落盘强制点：拿不到仓库根 —— 本钩子放行（这是钩子自身的问题）。"
    exit 0
fi

# 解释器：优先仓库约定的 3.14，退回落 PATH 的 python3（找不到就放行，理由同上）。
PY=""
for CAND in /opt/homebrew/bin/python3.14 python3.14 python3; do
    if command -v "$CAND" >/dev/null 2>&1; then PY="$CAND"; break; fi
done
if [ -z "$PY" ]; then
    warn "⚠ 落盘强制点：找不到可用的 python 解释器（本钩子放行；请检查开发环境）。"
    exit 0
fi

# >>> 锁核验开始（★ 反向验证锚点：`测试中心/开发工具/测试_git钩子.py` 按本行与下面
#     「锁核验结束」行**摘除整段**，用来证明「锁缺失被拒」这条判据真的由本段给出。
#     锚点若被改动，那条反向用例会**报错**（不是静默失效）—— 这是刻意的。）
LOCKOUT="$(cd "$ROOT" && "$PY" -c '
import sys

根 = sys.argv[1]
try:
    from 公共契约.运行时 import 仓库只读锁 as 锁
except BaseException as 错:
    print("锁核验=不可用")
    print("导入 公共契约.运行时.仓库只读锁 失败：%s: %s" % (type(错).__name__, 错))
    sys.exit(3)
if not 锁.支持内核锁():
    print("锁核验=不适用")
    print("本平台不支持内核级只读锁（仅 macOS 的 chflags）")
    sys.exit(2)
try:
    结果 = 锁.查询(根)
except BaseException as 错:
    print("锁核验=不可用")
    print("查询(%s) 抛错：%s: %s" % (根, type(错).__name__, 错))
    sys.exit(3)
# ★ 判红只看 **缺口数**（真缺口），不看 `未锁数`：未锁里还包含「活跃租约开窗」
#   （认领路径的写窗口，设计行为）—— 拿未锁数判红正是 2026-09-24 实测到的误拒。
print("锁核验=在位" if not 结果["缺口数"] else "锁核验=缺口")
print("锁核验开窗=%d" % 结果["开窗数"])
print("受管 %d 条目（%d 文件 + %d 目录）｜已锁 %d｜未锁 %d = 活跃租约开窗 %d ＋ 真缺口 %d"
      % (结果["文件数"] + 结果["目录数"], 结果["文件数"], 结果["目录数"],
         结果["已锁数"], 结果["未锁数"], 结果["开窗数"], 结果["缺口数"]))
if 结果["缺口数"]:
    if 结果["开窗数"]:
        print("（另有活跃租约开窗 %d 条 —— 那是设计行为，不算缺口，本钩子不为它拒）"
              % 结果["开窗数"])
    print("真缺口样本（前 %d 条）：" % len(结果["缺口样本"]))
    for 项 in 结果["缺口样本"]:
        print("  " + 项)
    sys.exit(1)
if 结果["开窗数"]:
    print("活跃租约开窗 %d 条（设计行为，不判红）：" % 结果["开窗数"])
    for 项 in 结果["开窗样本"]:
        print("  " + 项)
sys.exit(0)
' "$ROOT" 2>&1)"
LOCKRC=$?
LOCKMARK="$(printf '%s\n' "$LOCKOUT" | sed -n '1p')"
# 开窗条数（机器标记第 2 行；判据不可用/不适用时为空 ⇒ 当 0 处理）
LOCKWIN="$(printf '%s\n' "$LOCKOUT" | sed -n 's/^锁核验开窗=//p' | sed -n '1p')"

if [ "$LOCKMARK" = "锁核验=在位" ]; then
    # 锁在位 —— 判据一放行，继续走判据二。★ 但「在位」可能是**靠开窗豁免得来的**（整仓其实
    # 有未锁条目，只是它们全是活跃租约开窗）：那种情况如实说一声，不静默（否则读数看起来像
    # 「整仓全锁」）。开窗是认领路径的写窗口（设计行为），不算缺口、不拒提交。
    if [ "${LOCKWIN:-0}" != "0" ]; then
        warn "⚠ 落盘强制点·锁核验：在位（真缺口 0）—— 整仓另有**活跃租约开窗 ${LOCKWIN} 条**："
        printf '%s\n' "$LOCKOUT" | sed 's/^/    /' >&2
        warn "  开窗是「认领路径的写窗口」，设计行为，不算缺口（判据见本文件头部「判据一」）。"
    fi
elif [ "$LOCKMARK" = "锁核验=不适用" ]; then
    warn "⚠ 落盘强制点·锁核验：本平台不支持内核级只读锁（仅 macOS 有 chflags）⇒ 本腿放行。"
    warn "  fail-open 的理由见本文件头部「判据一·边界口径②」：机制在本平台不存在，不是判据坏了。"
elif [ "$LOCKMARK" = "锁核验=缺口" ]; then
    warn ""
    warn "✗ 提交被拒：**整仓内核锁有真缺口**（有受管条目没上锁，且不属于任何活跃租约的开窗）。"
    warn ""
    warn "  为什么拒：整仓只读锁（macOS chflags uchg）是华哥「不靠 agent 自觉、纯粹电脑硬件"
    warn "  权限管控」那条裁决的机器根据；锁有缺口时，终端/编辑器可以不经平台直接落盘，"
    warn "  本钩子后面那条「写入凭据」判据就只剩自觉。"
    warn ""
    warn "  ★ 两种「未锁」必须分开（2026-09-24 起，判据只看**缺口数**）："
    warn "    · 活跃租约开窗 = 认领路径的写窗口（设计行为）⇒ **不拒**；"
    warn "    · 真缺口       = 写腿中途被杀留下的     ⇒ **拒**（本分支）。"
    warn ""
    printf '%s\n' "$LOCKOUT" | sed 's/^/    /' >&2
    warn ""
    warn "  怎么改（照抄即可）："
    warn "    python3.14 运维脚本/仓库锁.py            # 上锁全仓（默认动作）"
    warn "    python3.14 运维脚本/仓库锁.py --补齐      # 只补**真缺口**（活跃租约开窗不锁）"
    warn "    python3.14 运维脚本/仓库锁.py --查看      # 只看状态（真缺口数 应为 0）"
    warn ""
    warn "  （git commit --no-verify 是 git 内建绕过口，本钩子拦不住 —— 见「可达上限①」。）"
    exit 1
else
    warn ""
    warn "✗ 提交被拒：锁核验**判据自身不可用**（导入失败 / 查询抛错 / 进程在启动处就被拦下）。"
    warn "  本仓口径：判据自身不可用 ⇒ 未核验一律 fail-closed（理由见头部「判据一·边界口径③」）。"
    warn ""
    printf '%s\n' "$LOCKOUT" | sed 's/^/    /' >&2
    warn ""
    warn "  先让核验跑得起来（在仓库根跑，且别带本仓 PYTHONPATH）："
    warn "    python3.14 运维脚本/仓库锁.py --查看      # 能出读数就说明判据可用"
    warn "  读数出来后按它给的方向补锁："
    warn "    python3.14 运维脚本/仓库锁.py            # 上锁全仓（默认动作）"
    warn "    python3.14 运维脚本/仓库锁.py --补齐      # 只补缺口"
    warn ""
    warn "  （核验进程退出码 ${LOCKRC}。若上面写着「拒绝执行…只能经 MCP 运行」，说明是带着本仓"
    warn "    PYTHONPATH 在终端直跑被 sitecustomize 拦了 —— 换成不设 PYTHONPATH 的普通终端跑。）"
    exit 1
fi
# <<< 锁核验结束

# 判据二·唯一腿：调平台判据（它内部合成「印记 + 写入凭据」两问）。
OUT="$(cd "$ROOT" && "$PY" -m 开发工具.MD文档生成 --拒绝手写校验 2>&1)"
RC=$?

if [ "$RC" -eq 0 ]; then
    exit 0
fi

warn ""
warn "✗ 提交被拒：本轮改动里有**未经平台工具落盘**的文件。"
warn ""
warn "  本仓规定（华哥 2026-09-23）：本项目的所有变动都要经 MCP 工具落盘；"
warn "  终端腿只允许用来改 MCP 自身。判据 = 该文件当前内容能否命中写入流水。"
warn ""
printf '%s\n' "$OUT" | sed 's/^/    /' >&2
warn ""
warn "  怎么改（★ 三条腿都得**经 MCP**，终端腿跑生成器同样会被写入腿拒）："
warn "    · 首选：用平台的写入能力重写这些文件（落盘时自动登记写入凭据）："
warn "        文件系统支持库.文件操作.写入文件"
warn "        文件系统支持库.文本补丁.应用精确替换"
warn "        文件系统支持库.文本补丁.批量应用精确替换"
warn "    · 或让生成器重生成 —— 但**要经 MCP 调**，不要终端直跑："
