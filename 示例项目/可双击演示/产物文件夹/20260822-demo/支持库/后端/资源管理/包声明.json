{
  "包id": "支持库.后端.资源管理",
  "名称": "资源管理",
  "类型": "支持库",
  "版本": "1.0.0",
  "说明": "原子资源操作：内容摘要、不可变快照、唯一运行目录、原子写入、原子替换、比较并交换、资源级跨进程短锁、安全释放。只依赖 Python 标准库。",
  "入口": "__init__.py",
  "依赖": [],
  "能力": [
    {
      "能力id": "资源管理.创建内容摘要",
      "名称": "创建内容摘要",
      "参数": [
        {"名称": "文件路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "文件路径"},
        {"名称": "算法", "类型": "文本型", "必填": false, "默认值": "sha256", "说明": "摘要算法"}
      ],
      "返回": "结果型",
      "说明": "创建文件内容摘要（sha256，分块读取）"
    },
    {
      "能力id": "资源管理.创建不可变快照",
      "名称": "创建不可变快照",
      "参数": [
        {"名称": "来源目录", "类型": "文本型", "必填": true, "默认值": null, "说明": "来源目录"},
        {"名称": "快照目录", "类型": "文本型", "必填": true, "默认值": null, "说明": "快照目标目录"}
      ],
      "返回": "结果型",
      "说明": "创建不可变快照并生成快照摘要"
    },
    {
      "能力id": "资源管理.创建唯一运行目录",
      "名称": "创建唯一运行目录",
      "参数": [
        {"名称": "基础目录", "类型": "文本型", "必填": true, "默认值": null, "说明": "基础目录"},
        {"名称": "前缀", "类型": "文本型", "必填": false, "默认值": "运行", "说明": "目录名前缀"}
      ],
      "返回": "结果型",
      "说明": "创建唯一运行目录（临时目录语义）"
    },
    {
      "能力id": "资源管理.原子写入",
      "名称": "原子写入",
      "参数": [
        {"名称": "目标路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "目标文件路径"},
        {"名称": "内容", "类型": "文本型", "必填": true, "默认值": null, "说明": "要写入的内容"}
      ],
      "返回": "结果型",
      "说明": "原子写入文件（临时文件+fsync+rename）"
    },
    {
      "能力id": "资源管理.原子替换",
      "名称": "原子替换",
      "参数": [
        {"名称": "目标路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "目标文件路径"},
        {"名称": "新内容", "类型": "文本型", "必填": true, "默认值": null, "说明": "新的文件内容"},
        {"名称": "期望版本", "类型": "文本型", "必填": false, "默认值": "", "说明": "期望版本号"}
      ],
      "返回": "结果型",
      "说明": "原子替换文件内容（可选版本比较）"
    },
    {
      "能力id": "资源管理.比较并交换",
      "名称": "比较并交换",
      "参数": [
        {"名称": "目标路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "目标文件路径"},
        {"名称": "期望值", "类型": "文本型", "必填": true, "默认值": null, "说明": "期望的当前值"},
        {"名称": "新值", "类型": "文本型", "必填": true, "默认值": null, "说明": "要写入的新值"}
      ],
      "返回": "结果型",
      "说明": "CAS 提交（并发冲突返回版本冲突）"
    },
    {
      "能力id": "资源管理.资源短锁",
      "名称": "资源短锁",
      "参数": [
        {"名称": "锁目录", "类型": "文本型", "必填": true, "默认值": null, "说明": "锁目录"},
        {"名称": "资源id", "类型": "文本型", "必填": true, "默认值": null, "说明": "资源id"},
        {"名称": "持有者", "类型": "文本型", "必填": false, "默认值": "", "说明": "持有者标识"}
      ],
      "返回": "结果型",
      "说明": "资源级跨进程短锁（mkdir 原子性）"
    },
    {
      "能力id": "资源管理.安全释放",
      "名称": "安全释放资源",
      "参数": [
        {"名称": "路径", "类型": "文本型", "必填": true, "默认值": null, "说明": "要释放的路径"}
      ],
      "返回": "结果型",
      "说明": "安全释放资源（幂等）"
    }
  ]
}
