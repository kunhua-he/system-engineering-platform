# Python 缓存与生成物
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# 工程缓存可重新生成，不作为正式源代码
工程缓存/

# 系统文件
.DS_Store

# 测试残留临时文件
.测试值.*.tmp

# 凭证与本地数据（朋友审计报告 P0-12：密钥提供者.py 把 .env 当凭证来源，未忽略则一次 git add -A 即泄漏）
.env
*.db
*.log
*.tmp

# 数据库文件的全部形态（*.db 之外还有 .sqlite3 与 SQLite 的 WAL/SHM 边车文件）
# 已入库的验证夹具不受本规则影响（git 对已跟踪文件不生效），此处只挡后续新增
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
