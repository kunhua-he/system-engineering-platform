{
  "标题": "第十四阶段公开操作契约（统一能力服务）",
  "版本": "1.0.0",
  "固定对象": "平台控制面/统一入口.py 的 统一能力服务（唯一实现）",
  "角色": ["普通用户", "调用Agent", "组件开发Agent", "平台维护者", "发布者"],
  "角色等级": {"普通用户": 1, "调用Agent": 2, "组件开发Agent": 3, "平台维护者": 4, "发布者": 5},
  "现有稳定操作": [
    {"操作": "确认需求", "最小角色": "调用Agent", "输入": ["需求id"], "返回": ["成功", "消息", "需求id"], "错误码": ["REQUIREMENT_REQUIRED"]},
    {"操作": "搜索能力", "最小角色": "普通用户", "输入": ["关键词", "限制"], "返回": ["成功", "结果表", "数量"], "错误码": []},
    {"操作": "查看能力", "最小角色": "普通用户", "输入": ["能力id"], "返回": ["成功", "能力"], "错误码": ["CAPABILITY_REQUIRED"]},
    {"操作": "生成装配计划", "最小角色": "调用Agent", "输入": ["需求id", "关键词"], "返回": ["成功", "计划"], "错误码": ["REQUIREMENT_REQUIRED", "REQUIREMENT_NOT_FOUND", "REQUIREMENT_UNCONFIRMED", "NO_CAPABILITIES"]},
    {"操作": "申请能力占用", "最小角色": "组件开发Agent", "输入": ["能力id", "领域", "契约指纹", "任务"], "返回": ["成功", "消息", "租约id"], "错误码": []},
    {"操作": "创建组件", "最小角色": "组件开发Agent", "输入": ["需求id", "复用决策", "资源预算", "允许修改路径", "组件声明", "能力id"], "返回": ["成功", "消息", "能力id"], "错误码": ["REQUIREMENT_REQUIRED", "REQUIREMENT_UNCONFIRMED", "NO_REUSE_DECISION", "BUDGET_INCOMPLETE", "NO_MODIFY_PATHS", "NO_COMPONENT_DECLARATION", "OCCUPANCY_DENIED", "REUSE_DENIED"]},
    {"操作": "验证组件", "最小角色": "组件开发Agent", "输入": ["命令", "参数", "工作目录", "超时秒"], "返回": ["成功", "退出码", "输出摘要"], "错误码": ["COMMAND_DENIED", "INVALID_ARGS", "VERIFY_TIMEOUT", "OUTPUT_LIMIT", "VERIFY_FAILED"]},
    {"操作": "调用能力", "最小角色": "调用Agent", "输入": ["能力id", "参数", "超时秒"], "返回": ["成功", "结果", "错误码", "消息", "可重试"], "错误码": ["CAPABILITY_NOT_FOUND", "PROVIDER_UNAVAILABLE", "PERMISSION_DENIED", "RESOURCE_EXCEEDED", "CALL_TIMEOUT"]},
    {"操作": "查看诊断", "最小角色": "平台维护者", "输入": [], "返回": ["成功", "监督报告", "证据数", "状态快照"], "错误码": []},
    {"操作": "提交候选包", "最小角色": "组件开发Agent", "输入": ["需求id", "复用决策", "文件表", "资源预算", "构建输入", "包id", "版本", "依赖"], "返回": ["成功", "消息", "制品摘要"], "错误码": ["REQUIREMENT_REQUIRED", "REQUIREMENT_UNCONFIRMED", "NO_REUSE_DECISION", "NO_FILES", "BUDGET_INCOMPLETE", "NO_SOURCE_PROVENANCE", "DEPENDENCY_DENIED"]},
    {"操作": "签名与发布", "最小角色": "发布者", "输入": ["制品摘要", "需求id", "灰度比例"], "返回": ["成功", "消息", "制品摘要", "激活指针", "证据id"], "错误码": ["ARTIFACT_NOT_FOUND", "NO_SIGNING_KEY", "RELEASE_DENIED", "SIGN_FAILED", "INSTALL_FAILED", "HEALTH_FAILED", "ACTIVATE_FAILED"]},
    {"操作": "回滚", "最小角色": "发布者", "输入": ["发布id", "回滚目标"], "返回": ["成功", "消息"], "错误码": []}
  ],
  "统一结果结构": ["成功", "错误码", "消息", "详细信息", "可重试"],
  "固定规则": [
    "所有入口（UI、Agent、MCP、命令行、Python）只做协议转换，必须调用统一能力服务",
    "禁止任何入口复制搜索、权限、调用和发布规则",
    "普通用户视图不泄漏实现、密钥和内部日志",
    "Agent 视图只使用四类稳定操作：搜索能力、查看能力、验证可用、调用能力",
    "组件开发Agent：需求确认、复用分析、占用租约、模板创建、候选提交；未确认需求和缺复用证据必须拒绝",
    "维护者：依赖、提供者、资源、证据、冲突裁决、诊断和回滚建议；无签名发布权限",
    "发布者：审核、签名、安装、灰度、激活、撤销、回滚；源码变化后旧签名失效",
    "所有并行工作包禁止修改本契约；扩展操作只允许主 Agent 在 S1/S2 串行修改"
  ]
}
